use flake
# The flake's inputs that direnv's `use flake` doesn't see: patches and
# modules feeding the generated editor configuration.
watch_file modules/emscripten/patches/*.patch
watch_file modules/glib/patches/*.patch
watch_file modules/toolchain/*.nix
watch_file modules/emscripten/checks/fixes/default.nix
watch_file modules/testing/default.nix
watch_file packages/worker-host/module.nix
