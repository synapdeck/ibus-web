{
  "name": "@ibus-web/panel",
  "version": "0.1.0",
  "description": "Framework-free IBus candidate and property panel.",
  "keywords": [
    "candidate-window",
    "ibus",
    "ime",
    "input-method"
  ],
  "homepage": "https://github.com/synapdeck/ibus-web/blob/master/docs/panel.md",
  "bugs": "https://github.com/synapdeck/ibus-web/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdeck/ibus-web.git",
    "directory": "packages/panel"
  },
  "files": [
    "dist",
    "LICENSES",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown && cp src/style.css dist/style.css",
    "prepack": "node ../../tools/pack-licenses/cli.ts prepack",
    "postpack": "node ../../tools/pack-licenses/cli.ts postpack",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@ibus-web/protocol": "workspace:*"
  },
  "devDependencies": {
    "@ibus-web/pack-licenses": "workspace:*",
    "@ibus-web/test-programs": "workspace:*",
    "@ibus-web/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "ibusWeb": {
    "assets": [
      "src/style.css"
    ]
  }
}
