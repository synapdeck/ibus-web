{
  "name": "@ibus-web/panel",
  "version": "0.0.0",
  "description": "Framework-free IBus candidate and property panel.",
  "homepage": "https://github.com/synapdeck/ibus-web",
  "bugs": "https://github.com/synapdeck/ibus-web/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdeck/ibus-web.git",
    "directory": "packages/panel"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown && cp src/style.css dist/style.css",
    "prepack": "cp ../../LICENSE-MIT ../../LICENSE-APACHE .",
    "postpack": "rm -f LICENSE-MIT LICENSE-APACHE",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@ibus-web/protocol": "workspace:*"
  },
  "devDependencies": {
    "@ibus-web/test-programs": "workspace:*",
    "@ibus-web/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "ibusWeb": {
    "assets": [
      "src/style.css"
    ]
  }
}
