{
  "name": "@ibus-web/protocol",
  "version": "0.0.0",
  "description": "The typed wire protocol and GVariant codec for ibus-web.",
  "keywords": [
    "gvariant",
    "ibus",
    "input-method",
    "protocol",
    "webassembly"
  ],
  "homepage": "https://github.com/synapdeck/ibus-web/blob/master/docs/protocol.md",
  "bugs": "https://github.com/synapdeck/ibus-web/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdeck/ibus-web.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "PROTOCOL.md",
    "LICENSES",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench": "vitest run --configLoader native --config vitest.bench.config.ts",
    "build": "rm -rf dist && tsdown",
    "generate:protocol-h": "node scripts/protocol-h.ts",
    "generate:protocol-md": "node scripts/protocol-md.ts",
    "prepack": "node ../../tools/pack-licenses/cli.ts prepack",
    "postpack": "node ../../tools/pack-licenses/cli.ts postpack",
    "test": "vitest run --configLoader native"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ibus-web/pack-licenses": "workspace:*",
    "@ibus-web/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
