{
  "name": "@ibus-web/protocol",
  "version": "0.0.0",
  "description": "The typed wire protocol and GVariant codec for ibus-web.",
  "homepage": "https://github.com/synapdeck/ibus-web/blob/master/docs/protocol.md",
  "bugs": "https://github.com/synapdeck/ibus-web/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdeck/ibus-web.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "PROTOCOL.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "prepack": "cp ../../LICENSE-MIT ../../LICENSE-APACHE .",
    "postpack": "rm -f LICENSE-MIT LICENSE-APACHE",
    "test": "vitest run --configLoader native"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
