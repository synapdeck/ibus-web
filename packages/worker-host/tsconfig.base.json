// Sources are split by the environment they run in. Each directory has its
// own tsconfig.json extending this one, so no file sees another
// environment's globals, and an editor checks a file under the config
// nearest to it:
//
//   src/shared/   no environment's globals: what the page and the host share.
//   src/worker/   WebWorker globals: the host's and the relay's Workers.
//   test/worker/  WebWorker globals: the host's test build, instrumented.
//   test/shared/  no environment's globals: the scenarios and the page's side
//                 of the control buffer, for either test environment.
//   test/node/    Node globals: the tests under Node, Vitest's
//                 configuration's helpers, and the worker_threads adapter.
//   test/browser/ DOM globals: the tests in a browser.
//
// tsdown bundles what runs; these configs only check it.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Vitest's declarations name both DOM and Node types, and each
    // environment has only one of them.
    "skipLibCheck": true
  }
}
