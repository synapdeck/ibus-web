{
  "name": "@ibus-web/worker-host",
  "version": "0.1.1",
  "description": "The Worker host for ibus-web: runs the WebAssembly IBus runtime and its engines in a dedicated Worker, with storage and engine-data install.",
  "keywords": [
    "ibus",
    "ime",
    "input-method",
    "web-worker",
    "webassembly"
  ],
  "homepage": "https://github.com/synapdeck/ibus-web/blob/master/docs/worker-host.md",
  "bugs": "https://github.com/synapdeck/ibus-web/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdeck/ibus-web.git",
    "directory": "packages/worker-host"
  },
  "files": [
    "dist/shared",
    "dist/worker",
    "types/worker.d.ts",
    "types/relay.d.ts",
    "types/storage.d.ts",
    "LICENSES",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/worker/index.js",
    "./dist/worker/relay.js",
    "./dist/worker/storage.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./relay": {
      "types": "./types/relay.d.ts",
      "default": "./dist/worker/relay.js"
    },
    "./storage": {
      "types": "./types/storage.d.ts",
      "default": "./dist/worker/storage.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown && tsc -p tsconfig.types.json",
    "prepack": "node ../../tools/pack-licenses/cli.ts prepack",
    "postpack": "node ../../tools/pack-licenses/cli.ts postpack",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@ibus-web/protocol": "workspace:*",
    "@ibus-web/runtime": "workspace:*",
    "brotli-dec-wasm": "catalog:",
    "modern-tar": "^0.8.5"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ibus-web/pack-licenses": "workspace:*",
    "@ibus-web/test-programs": "workspace:*",
    "@ibus-web/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
