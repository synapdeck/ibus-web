{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ibus-web/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": [],
    // tsdown writes the declarations from each file alone.
    "declaration": true,
    "isolatedDeclarations": true,
    "skipLibCheck": true
  },
  "include": ["src/shared"]
}
