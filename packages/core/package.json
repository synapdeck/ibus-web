{
  "name": "@ibus-web/core",
  "version": "0.0.0",
  "description": "Page-side IBus key translation and input routing.",
  "homepage": "https://github.com/synapdeck/ibus-web",
  "bugs": "https://github.com/synapdeck/ibus-web/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdeck/ibus-web.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSES",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "exports": {
    "./keys": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    ".": {
      "types": "./dist/page/index.d.ts",
      "default": "./dist/page/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "prepack": "cp ../../LICENSE-MIT ../../LICENSE-APACHE . && mkdir -p LICENSES && cp ../../LICENSES/MIT-open-group.txt ../../LICENSES/HPND.txt ../../LICENSES/BSD-3-Clause.txt LICENSES/ && cp ../../NOTICES/keysymdef.txt LICENSES/keysymdef-notice.txt && cp ../../NOTICES/chromium.txt LICENSES/chromium-notice.txt && cp ../../LICENSES/LicenseRef-xkeyboard-config.txt LICENSES/xkeyboard-config-COPYING.txt",
    "postpack": "rm -rf LICENSES && rm -f LICENSE-MIT LICENSE-APACHE",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@ibus-web/protocol": "workspace:*",
    "@ibus-web/worker-host": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ibus-web/test-programs": "workspace:*",
    "@ibus-web/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
