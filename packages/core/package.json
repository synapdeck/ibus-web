{
  "name": "@ibus-web/core",
  "version": "0.0.0",
  "description": "Page-side IBus key translation and input routing.",
  "keywords": [
    "ibus",
    "ime",
    "input-method",
    "keyboard",
    "webassembly"
  ],
  "homepage": "https://github.com/synapdeck/ibus-web/blob/master/docs/core.md",
  "bugs": "https://github.com/synapdeck/ibus-web/issues",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapdeck/ibus-web.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSES",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./keys": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    ".": {
      "types": "./dist/page/index.d.ts",
      "default": "./dist/page/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "prepack": "node ../../tools/pack-licenses/cli.ts prepack",
    "postpack": "node ../../tools/pack-licenses/cli.ts postpack",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@ibus-web/protocol": "workspace:*",
    "@ibus-web/worker-host": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@ibus-web/pack-licenses": "workspace:*",
    "@ibus-web/test-programs": "workspace:*",
    "@ibus-web/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
