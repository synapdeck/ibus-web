// Each config checks the files of one environment, so no file sees another
// environment's globals: the page, the Node-run Playwright suites and smoke
// test, and the build's and Playwright's configurations.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "files": [],
  "references": [
    { "path": "./tsconfig.page.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.config.json" }
  ]
}
