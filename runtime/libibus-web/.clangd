# Fallback commands run in each source file's directory. Prefer in-tree
# headers; the generated root configuration supplies installed build outputs.
If:
  PathMatch: (src|tests)/[^/]+
CompileFlags:
  Add:
    - -I../include
    - -I../include/ibus-1.0
---
If:
  PathMatch: src/ibus/.*
CompileFlags:
  Add:
    - -DIBUS_COMPILATION
    - -I../../include/ibus-1.0
---
If:
  PathMatch: include/ibus-1.0/.*
CompileFlags:
  Add:
    - -DIBUS_COMPILATION
