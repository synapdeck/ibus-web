// Type-checks the backend's JavaScript library, which runs on the backend's
// thread: a Worker. emscripten-types/ is generated, not written: the types
// of what the library uses from Emscripten, from a link of the library.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  // Emscripten bundles these files into its own output as written, as
  // scripts, so they are checked as such rather than as Node modules.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "webworker"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": []
  },
  "files": ["libwasmfs_idb.js", "emscripten-library.d.ts", "emscripten-types/globals.d.ts"]
}
