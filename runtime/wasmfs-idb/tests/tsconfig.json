// Type-checks the tests' JavaScript libraries and --post-js, which run on
// every thread of a test program, the backend's Worker among them.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  // Emscripten bundles these files into its own output as written, as
  // scripts, so they are checked as such rather than as Node modules.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "webworker"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": []
  },
  "include": ["*.js", "*.d.ts", "../src/emscripten-library.d.ts"]
}
