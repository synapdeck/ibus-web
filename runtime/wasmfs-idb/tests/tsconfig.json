// Type-checks the tests' JavaScript libraries and --post-js, which run on
// every thread of a test program, the backend's Worker among them.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.emscripten-js.json",
  "include": ["*.js", "*.d.ts", "../src/emscripten-library.d.ts"]
}
