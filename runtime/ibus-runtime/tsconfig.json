// Type-checks the runtime's --pre-js, which Emscripten bundles into the
// runtime as written, as a script. The runtime runs in Workers.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023", "webworker"],
    "types": []
  },
  "files": ["host-memory.js", "pre-js.d.ts"]
}
