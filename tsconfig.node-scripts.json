// For scripts the Nix builds run with Node, which strips their types: each
// directory of them has a tsconfig.json extending this.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Explicit, because the default for the target includes DOM.
    "lib": ["es2023"],
    // types/ holds the repository's own declarations of what Node has but
    // @types/node doesn't declare.
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["node", "webassembly"]
  }
}
