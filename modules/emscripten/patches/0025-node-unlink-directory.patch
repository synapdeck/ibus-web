Node file systems: fail unlink() on a directory with EISDIR

NODERAWFS's unlink() and WasmFS's Node backend's _wasmfs_node_unlink()
call Node's fs.unlinkSync(), so a directory fails with the host's error:
EISDIR on Linux, EPERM on macOS. musl's remove() and the backend's
removeChild() call rmdir() only on EISDIR, so on macOS remove() fails on
every directory, and under WasmFS rmdir() does too. Report EISDIR for a
directory, as Linux does, whatever the host.

Upstream: not filed yet
Draft: docs/upstream/emscripten-node-unlink-directory.md

diff --git a/src/lib/libnoderawfs.js b/src/lib/libnoderawfs.js
index a3908ab..e4cff59 100644
--- a/src/lib/libnoderawfs.js
+++ b/src/lib/libnoderawfs.js
@@ -99,7 +99,14 @@ addToLibrary({
     rename(...args) { fs.renameSync(...args); },
     rmdir(...args) { fs.rmdirSync(...args); },
     readdir(...args) { return ['.', '..'].concat(fs.readdirSync(...args)); },
-    unlink(...args) { fs.unlinkSync(...args); },
+    unlink(path) {
+      // Linux's unlink() fails with EISDIR on a directory, which musl's
+      // remove() takes as its cue to call rmdir(); macOS's fails with EPERM.
+      if (fs.lstatSync(path).isDirectory()) {
+        throw new FS.ErrnoError({{{ cDefs.EISDIR }}});
+      }
+      fs.unlinkSync(path);
+    },
     readlink(...args) { return fs.readlinkSync(...args); },
     stat(path, dontFollow) {
       var stat = dontFollow ? fs.lstatSync(path) : fs.statSync(path);
diff --git a/src/lib/libwasmfs_node.js b/src/lib/libwasmfs_node.js
index 15bec76..b1d5b90 100644
--- a/src/lib/libwasmfs_node.js
+++ b/src/lib/libwasmfs_node.js
@@ -143,7 +143,13 @@ var wasmFSNodeLibrary = {
   _wasmfs_node_unlink__deps: ['$wasmfsTry'],
   _wasmfs_node_unlink: (path_p) => {
     return wasmfsTry(() => {
-      fs.unlinkSync(UTF8ToString(path_p))
+      var path = UTF8ToString(path_p);
+      // Linux's unlink() fails with EISDIR on a directory, which removeChild()
+      // takes as its cue to call rmdir(); macOS's fails with EPERM.
+      if (fs.lstatSync(path).isDirectory()) {
+        return {{{ cDefs.EISDIR }}};
+      }
+      fs.unlinkSync(path)
       // implicitly return 0
     });
   },
