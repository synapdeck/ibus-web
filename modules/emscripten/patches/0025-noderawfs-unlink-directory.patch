NODERAWFS: fail unlink() on a directory with EISDIR

NODERAWFS's unlink() calls Node's fs.unlinkSync(), so a directory fails
with the host's error: EISDIR on Linux, EPERM on macOS. musl's remove()
calls rmdir() only on EISDIR, so on macOS remove() fails on every
directory. Report EISDIR for a directory, as Linux does, whatever the
host.

Upstream: not filed yet
Draft: docs/upstream/emscripten-noderawfs-unlink-directory.md

diff --git a/src/lib/libnoderawfs.js b/src/lib/libnoderawfs.js
index a3908ab..e4cff59 100644
--- a/src/lib/libnoderawfs.js
+++ b/src/lib/libnoderawfs.js
@@ -99,7 +99,14 @@ addToLibrary({
     rename(...args) { fs.renameSync(...args); },
     rmdir(...args) { fs.rmdirSync(...args); },
     readdir(...args) { return ['.', '..'].concat(fs.readdirSync(...args)); },
-    unlink(...args) { fs.unlinkSync(...args); },
+    unlink(path) {
+      // Linux's unlink() fails with EISDIR on a directory, which musl's
+      // remove() takes as its cue to call rmdir(); macOS's fails with EPERM.
+      if (fs.lstatSync(path).isDirectory()) {
+        throw new FS.ErrnoError({{{ cDefs.EISDIR }}});
+      }
+      fs.unlinkSync(path);
+    },
     readlink(...args) { return fs.readlinkSync(...args); },
     stat(path, dontFollow) {
       var stat = dontFollow ? fs.lstatSync(path) : fs.statSync(path);
