WasmFS Node backend: open() and close() take host errors for success

_wasmfs_node_open() returned a positive errno, which NodeState::open()
took for a file descriptor, and NodeState::close() passed on a positive
errno, which tripped __wasi_fd_close()'s assertion.

Upstream: not filed yet
Draft: docs/upstream/emscripten-wasmfs-node-open-close-errors.md

diff --git a/src/lib/libwasmfs_node.js b/src/lib/libwasmfs_node.js
index 82888a9..0148421 100644
--- a/src/lib/libwasmfs_node.js
+++ b/src/lib/libwasmfs_node.js
@@ -167,9 +167,15 @@ var wasmFSNodeLibrary = {
     return wasmfsTry(() => fs.ftruncateSync(fd, len));
   },
 
-  _wasmfs_node_open__deps: ['$wasmfsTry'],
+  _wasmfs_node_open__deps: ['$wasmfsNodeConvertNodeCode'],
   _wasmfs_node_open: (path_p, mode_p) => {
-    return wasmfsTry(() => fs.openSync(UTF8ToString(path_p), UTF8ToString(mode_p)));
+    // A file descriptor on success, a negated errno on failure.
+    try {
+      return fs.openSync(UTF8ToString(path_p), UTF8ToString(mode_p));
+    } catch (e) {
+      if (!e.code) throw e;
+      return -wasmfsNodeConvertNodeCode(e);
+    }
   },
 
   _wasmfs_node_rename__deps: ['$wasmfsTry'],
diff --git a/system/lib/wasmfs/backends/node_backend.cpp b/system/lib/wasmfs/backends/node_backend.cpp
index 4bfd0f1..b4adb94 100644
--- a/system/lib/wasmfs/backends/node_backend.cpp
+++ b/system/lib/wasmfs/backends/node_backend.cpp
@@ -90,7 +90,7 @@ public:
   int close() {
     int ret = 0;
     if (--openCount == 0) {
-      ret = _wasmfs_node_close(fd);
+      ret = -_wasmfs_node_close(fd);
       *this = NodeState(path);
     }
     return ret;
