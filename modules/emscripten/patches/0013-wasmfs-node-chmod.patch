+  // Set the access and modification times, in ms. INFINITY leaves that time
+  // unchanged.
+  [[nodiscard]] int setTimes(double atime, double mtime) {
+    if (atime == INFINITY && mtime == INFINITY) {
+      return 0;
+    }
+    if (auto err = file->setTimes(atime, mtime)) {
+      return err;
+    }
+    if (atime != INFINITY) {
+      file->atime = atime;
+    }
+    if (mtime != INFINITY) {
+      file->mtime = mtime;
+    }
+    return 0;
+  }
 
