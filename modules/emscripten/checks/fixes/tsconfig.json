// Type-checks the checks' --pre-js, which Emscripten bundles into programs
// run under Node, as written, as a script, and their Vitest test file.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"]
  },
  "files": ["size-pre.js", "pre-js.d.ts", "fixes.test.ts", "webassembly.d.ts"]
}
