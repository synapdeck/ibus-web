// Type-checks the report library, which runs on a program's main thread: a
// Worker in browsers, Node's own thread under Node. emscripten-types/ is
// generated, not written: the types of what the library uses from
// Emscripten, from a link of the library.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.emscripten-js.json",
  "files": [
    "report.js",
    "report.d.ts",
    "../../../runtime/wasmfs-idb/src/emscripten-library.d.ts",
    "emscripten-types/globals.d.ts"
  ]
}
