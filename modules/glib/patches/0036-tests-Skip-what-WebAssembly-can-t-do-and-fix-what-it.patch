+static int
+compare_strings (const void *a,
+                 const void *b)
+{
+  return g_strcmp0 (*(const gchar * const *) a, *(const gchar * const *) b);
+}
+
+/* Completions come in the order the file system lists the directory. */
+static GStrv
+get_sorted_completions (GFilenameCompleter *completer,
+                        const gchar        *initial_text)
+{
+  GStrv completions = g_filename_completer_get_completions (completer, initial_text);
+
+  qsort (completions, g_strv_length (completions), sizeof (gchar *), compare_strings);
+  return completions;
+}
+
+static void
+got_completion_data_cb (GFilenameCompleter *completer,
+                        gpointer            user_data)
+{
+  g_main_loop_quit (user_data);
+}
