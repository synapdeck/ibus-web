From ca9dfb58619ab49e7d7ac09b99ce594651b685c8 Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Tue, 29 Sep 2026 18:26:24 -0700
Subject: [PATCH 17/18] Build the tools on Emscripten

Three tools link against Unix sources that aren't built for
Emscripten: gtester opens its report pipe with g_unix_open_pipe(), the
gio tool's info and launch commands use the Unix mount table and
GDesktopAppInfo, and gapplication reads desktop files.

On WebAssembly, gtester opens the pipe with pipe(); spawning the test
binary then reports that it's unsupported. gio info leaves out the Unix
mount line, and gio launch reports that it isn't supported on this
platform, as it already does on Windows and macOS. gapplication list
finds no D-Bus activatable applications, and list-actions reports that
it can't find the application's desktop file.

The tools run under Node with its filesystem, so configure's
/proc/self/cmdline run check would pass there, although the library
also runs in browsers, which have no /proc. Take its result from the
have_proc_self_cmdline cross property on Emscripten, as for a cross
build that can't run host programs.

Upstream-Status: Inappropriate [Wasm-specific]
---
 gio/gapplication-tool.c | 11 +++++++++++
 gio/gio-tool-info.c     |  6 +++---
 gio/gio-tool-launch.c   |  6 +++---
 glib/gtester.c          |  9 +++++++++
 meson.build             |  4 +++-
 5 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/gio/gapplication-tool.c b/gio/gapplication-tool.c
index 78a57607e..e107597e4 100644
--- a/gio/gapplication-tool.c
+++ b/gio/gapplication-tool.c
@@ -211,6 +211,8 @@ app_list (gchar **args)
     {
       GDesktopAppInfo *info = apps->data;
 
+      /* WebAssembly has no desktop files, so nothing is D-Bus activatable. */
+#ifndef G_PLATFORM_WASM
       if (G_IS_DESKTOP_APP_INFO (info))
         if (g_desktop_app_info_get_boolean (info, "DBusActivatable"))
           {
@@ -226,6 +228,7 @@ app_list (gchar **args)
                 g_free (id);
               }
           }
+#endif
 
       apps = g_list_delete_link (apps, apps);
       g_object_unref (info);
@@ -405,10 +408,12 @@ app_launch (gchar **args)
 static int
 app_list_actions (gchar **args)
 {
+#ifndef G_PLATFORM_WASM
   const gchar * const *actions;
   GDesktopAppInfo *app_info;
   gchar *filename;
   gint i;
+#endif
 
   if (!app_check_name (args, "list-actions"))
     return 1;
@@ -419,6 +424,11 @@ app_list_actions (gchar **args)
       app_help (FALSE, "list-actions");
     }
 
+#ifdef G_PLATFORM_WASM
+  /* WebAssembly has no desktop files to read actions from. */
+  g_printerr (_("unable to find desktop file for application %s\n"), args[0]);
+  return 1;
+#else
   filename = g_strconcat (args[0], ".desktop", NULL);
   app_info = g_desktop_app_info_new (filename);
   g_free (filename);
@@ -437,6 +447,7 @@ app_list_actions (gchar **args)
   g_object_unref (app_info);
 
   return 0;
+#endif
 }
 
 int
diff --git a/gio/gio-tool-info.c b/gio/gio-tool-info.c
index 64d3c194e..006499e8f 100644
--- a/gio/gio-tool-info.c
+++ b/gio/gio-tool-info.c
@@ -24,7 +24,7 @@
 #include <gio/gio.h>
 #include <gi18n.h>
 
-#ifdef G_OS_UNIX
+#if defined(G_OS_UNIX) && !defined(G_PLATFORM_WASM)
 #include <gio/gunixmounts.h>
 #endif
 
@@ -153,7 +153,7 @@ show_info (GFile *file, GFileInfo *info)
   char *escaped, *uri, *flatten;
   goffset size;
   const char *path;
-#ifdef G_OS_UNIX
+#if defined(G_OS_UNIX) && !defined(G_PLATFORM_WASM)
   GUnixMountEntry *entry;
 #endif
 
@@ -214,7 +214,7 @@ show_info (GFile *file, GFileInfo *info)
       g_print (_("local path: %s\n"), flatten);
       free (flatten);
 
-#ifdef G_OS_UNIX
+#if defined(G_OS_UNIX) && !defined(G_PLATFORM_WASM)
       entry = g_unix_mount_entry_at (path, NULL);
       if (entry == NULL)
         entry = g_unix_mount_entry_for (path, NULL);
diff --git a/gio/gio-tool-launch.c b/gio/gio-tool-launch.c
index de161580e..e1b668999 100644
--- a/gio/gio-tool-launch.c
+++ b/gio/gio-tool-launch.c
@@ -23,7 +23,7 @@
 
 #include <gio/gio.h>
 
-#if defined(G_OS_UNIX) && !defined(__APPLE__)
+#if defined(G_OS_UNIX) && !defined(__APPLE__) && !defined(G_PLATFORM_WASM)
 #include <gio/gdesktopappinfo.h>
 #endif
 
@@ -40,7 +40,7 @@ handle_launch (int argc, char *argv[], gboolean do_help)
 {
   GOptionContext *context;
   GError *error = NULL;
-#if defined(G_OS_UNIX) && !defined(__APPLE__)
+#if defined(G_OS_UNIX) && !defined(__APPLE__) && !defined(G_PLATFORM_WASM)
   int i;
   GAppInfo *app = NULL;
   GAppLaunchContext *app_context = NULL;
@@ -83,7 +83,7 @@ handle_launch (int argc, char *argv[], gboolean do_help)
 
   g_option_context_free (context);
 
-#if !defined(G_OS_UNIX) || defined(__APPLE__)
+#if !defined(G_OS_UNIX) || defined(__APPLE__) || defined(G_PLATFORM_WASM)
   print_error (_("The launch command is not currently supported on this platform"));
   retval = 1;
 #else
diff --git a/glib/gtester.c b/glib/gtester.c
index 24f84f6c9..40b4706f9 100644
--- a/glib/gtester.c
+++ b/glib/gtester.c
@@ -305,7 +305,16 @@ launch_test_binary (const char *binary,
   gboolean loop_pending;
   gint i = 0;
 
+#ifdef G_PLATFORM_WASM
+  /* glib-unix.c isn't built for WebAssembly; spawning the test binary then
+   * reports that it's unsupported. */
+  if (pipe (report_pipe) != 0)
+    g_set_error_literal (&error, G_FILE_ERROR, g_file_error_from_errno (errno),
+                         g_strerror (errno));
+  if (error != NULL)
+#else
   if (!g_unix_open_pipe (report_pipe, O_CLOEXEC, &error))
+#endif
     {
       if (subtest_mode_fatal)
         g_error ("Failed to open pipe for test binary: %s: %s", binary, error->message);
diff --git a/meson.build b/meson.build
index c4dbd8789..25274dffd 100644
--- a/meson.build
+++ b/meson.build
@@ -2510,7 +2510,9 @@ main (void)
   exit (__getcmdline ());
 }'''
 
-if cc_can_run
+# The tools run under Node, whose filesystem has the host's
+# /proc/self/cmdline, but the library also runs in browsers, which don't.
+if cc_can_run and host_system != 'emscripten'
   rres = cc.run(cmdline_test_code, name : '/proc/self/cmdline')
   have_proc_self_cmdline = rres.compiled() and rres.returncode() == 0
 else
