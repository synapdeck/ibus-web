+/* A character the target charset lacks is found also when the conversion
+ * runs out of room for its output, or ends in an incomplete character. */
+static void
+test_unrepresentable (void)
+{
+  gchar *out;
+  gsize bytes_read;
+  GError *error = NULL;
+
+  /* "½漢": ISO-2022-JP takes more bytes for the kanji than UTF-8 does. */
+  out = g_convert ("\xc2\xbd\xe6\xbc\xa2", -1, "ISO-2022-JP", "UTF-8",
+                   NULL, NULL, &error);
+  g_assert_error (error, G_CONVERT_ERROR, G_CONVERT_ERROR_ILLEGAL_SEQUENCE);
+  g_assert_null (out);
+  g_clear_error (&error);
+
+  out = g_convert_with_fallback ("\xc2\xbd\xe6\xbc\xa2", -1, "ISO-2022-JP", "UTF-8",
+                                 "?", NULL, NULL, &error);
+  g_assert_no_error (error);
+  g_assert_cmpint (out[0], ==, '?');
+  g_assert_null (strchr (out, '*'));
+  g_free (out);
+
+  /* "漢½漢": the fallback takes ISO-2022-JP back to ASCII between kanji. */
+  out = g_convert_with_fallback ("\xe6\xbc\xa2\xc2\xbd\xe6\xbc\xa2", -1,
+                                 "ISO-2022-JP", "UTF-8", "?", NULL, NULL, &error);
+  g_assert_no_error (error);
+  g_assert_cmpstr (out, ==, "\x1b$B4A\x1b(B?\x1b$B4A\x1b(B");
+  g_free (out);
+
+  /* A fallback the target lacks, "½" followed by kanji that take more room. */
+  out = g_convert_with_fallback ("\xc2\xbd", -1, "ISO-2022-JP", "UTF-8",
+                                 "\xc2\xbd\xe6\xbc\xa2\xe6\xbc\xa2\xe6\xbc\xa2",
+                                 NULL, NULL, &error);
+  g_assert_error (error, G_CONVERT_ERROR, G_CONVERT_ERROR_ILLEGAL_SEQUENCE);
+  g_assert_null (out);
+  g_clear_error (&error);
+
+  /* "a½" and the first byte of "é". */
+  out = g_convert ("a\xc2\xbd\xc3", 4, "ISO-8859-15", "UTF-8",
+                   &bytes_read, NULL, &error);
+  g_assert_error (error, G_CONVERT_ERROR, G_CONVERT_ERROR_ILLEGAL_SEQUENCE);
+  g_assert_null (out);
+  g_clear_error (&error);
+}
+
 static void
