+/* A character the target charset lacks stops the conversion before it, also
+ * when the same call goes on to run out of input in the middle of a
+ * character or out of room for the output. */
+static void
+test_charset_unrepresentable (void)
+{
+  GConverter *conv;
+  GConverterResult res;
+  gchar out[16];
+  gsize bytes_read, bytes_written;
+  GError *error = NULL;
+
+  conv = (GConverter *) g_charset_converter_new ("ISO-8859-15", "UTF-8", NULL);
+
+  /* "a½" and the first byte of "é". */
+  res = g_converter_convert (conv, "a\xc2\xbd\xc3", 4, out, sizeof out,
+                             G_CONVERTER_NO_FLAGS, &bytes_read, &bytes_written, &error);
+  g_assert_no_error (error);
+  g_assert_cmpint (res, ==, G_CONVERTER_CONVERTED);
+  g_assert_cmpuint (bytes_read, ==, 1);
+  g_assert_cmpmem (out, bytes_written, "a", 1);
+
+  res = g_converter_convert (conv, "\xc2\xbd\xc3", 3, out, sizeof out,
+                             G_CONVERTER_NO_FLAGS, &bytes_read, &bytes_written, &error);
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_cmpint (res, ==, G_CONVERTER_ERROR);
+  g_clear_error (&error);
+
+  /* Room for three bytes of "ab*cd". */
+  g_converter_reset (conv);
+  res = g_converter_convert (conv, "ab\xc2\xbd" "cd", 6, out, 3,
+                             G_CONVERTER_INPUT_AT_END, &bytes_read, &bytes_written, &error);
+  g_assert_no_error (error);
+  g_assert_cmpint (res, ==, G_CONVERTER_CONVERTED);
+  g_assert_cmpuint (bytes_read, ==, 2);
+  g_assert_cmpmem (out, bytes_written, "ab", 2);
+
+  g_object_unref (conv);
+}
+
+/* A source charset with state reads the same however the input is cut into
+ * calls and however little room the output has. */
+static void
+test_charset_stateful (void)
+{
+  GConverter *conv;
+  GConverterResult res;
+  gchar out[16];
+  gsize bytes_read, bytes_written;
+  GError *error = NULL;
+
+  /* A byte order mark and "abcd", with room for "abc". */
+  conv = (GConverter *) g_charset_converter_new ("UTF-8", "UTF-16", NULL);
+  res = g_converter_convert (conv, "\xff\xfe" "a\0b\0c\0d\0", 10, out, 3,
+                             G_CONVERTER_NO_FLAGS, &bytes_read, &bytes_written, &error);
+  g_assert_no_error (error);
+  g_assert_cmpint (res, ==, G_CONVERTER_CONVERTED);
+  g_assert_cmpuint (bytes_read, ==, 8);
+  g_assert_cmpmem (out, bytes_written, "abc", 3);
+  g_object_unref (conv);
+
+  /* "亜", then "唖" in the state the first call left and "abcdef" after a
+   * switch back to ASCII, with room for "唖abc". */
+  conv = (GConverter *) g_charset_converter_new ("UTF-8", "ISO-2022-JP", NULL);
+  res = g_converter_convert (conv, "\x1b$B0!", 5, out, sizeof out,
+                             G_CONVERTER_NO_FLAGS, &bytes_read, &bytes_written, &error);
+  g_assert_no_error (error);
+  g_assert_cmpint (res, ==, G_CONVERTER_CONVERTED);
+  g_assert_cmpuint (bytes_read, ==, 5);
+  g_assert_cmpmem (out, bytes_written, "\xe4\xba\x9c", 3);
+
+  res = g_converter_convert (conv, "0\"\x1b(Babcdef", 11, out, 6,
+                             G_CONVERTER_NO_FLAGS, &bytes_read, &bytes_written, &error);
+  g_assert_no_error (error);
+  g_assert_cmpint (res, ==, G_CONVERTER_CONVERTED);
+  g_assert_cmpuint (bytes_read, ==, 8);
+  g_assert_cmpmem (out, bytes_written, "\xe5\x94\x96" "abc", 6);
+  g_object_unref (conv);
+}
+
 static void
