From 90c1405dbaf8d7dac1c0dd4a53970a2829f671ae Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Tue, 29 Sep 2026 16:53:57 -0700
Subject: [PATCH 14/31] gwakeup: Make acknowledging and freeing no-ops on
 WebAssembly

Every GMainContext owns a GWakeup, and unreffing the last reference to
a context frees it, so g_wakeup_free() aborting made any context that
is ever freed fatal. There is nothing to release: g_wakeup_new()
returns NULL on WebAssembly.

The context's wakeup record is never registered for polling there, so
give it fd -1: left at 0, a source polling fd 0 would be taken for the
wakeup, and g_wakeup_acknowledge() would be called for it. That call
must not abort either.

Upstream-Status: Inappropriate [Wasm-specific]
---
 glib/gmain.c   | 4 ++++
 glib/gwakeup.c | 8 ++------
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/glib/gmain.c b/glib/gmain.c
index 60d949541..268de6ac4 100644
--- a/glib/gmain.c
+++ b/glib/gmain.c
@@ -714,6 +714,10 @@ g_main_context_new_with_flags (GMainContextFlags flags)
 #ifndef G_PLATFORM_WASM
   g_wakeup_get_pollfd (context->wakeup, &context->wake_up_rec);
   g_main_context_add_poll_unlocked (context, 0, &context->wake_up_rec);
+#else
+  /* No wakeup fd is polled, so keep the record from matching a source
+   * that polls fd 0. */
+  context->wake_up_rec.fd = -1;
 #endif
 
 #ifdef G_MAIN_POLL_DEBUG
diff --git a/glib/gwakeup.c b/glib/gwakeup.c
index f5569998d..9f6e6d524 100644
--- a/glib/gwakeup.c
+++ b/glib/gwakeup.c
@@ -221,9 +221,7 @@ g_wakeup_get_pollfd (GWakeup *wakeup,
 void
 g_wakeup_acknowledge (GWakeup *wakeup)
 {
-#ifdef G_PLATFORM_WASM
-  g_error ("g_wakeup_acknowledge is no-op on WebAssembly");
-#else
+#ifndef G_PLATFORM_WASM
   int res;
 
   if (wakeup->fds[1] == -1)
@@ -302,9 +300,7 @@ g_wakeup_signal (GWakeup *wakeup)
 void
 g_wakeup_free (GWakeup *wakeup)
 {
-#ifdef G_PLATFORM_WASM
-  g_error ("g_wakeup_free is no-op on WebAssembly");
-#else
+#ifndef G_PLATFORM_WASM
   close (wakeup->fds[0]);
 
   if (wakeup->fds[1] != -1)
