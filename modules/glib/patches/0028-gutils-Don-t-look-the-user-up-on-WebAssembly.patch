From 4f733676ddddb29e35fdccf34df0f7ab7e0c9ff9 Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 16:58:58 -0700
Subject: [PATCH 28/34] gutils: Don't look the user up on WebAssembly

Emscripten's getpwnam_r(), getpwuid_r() and getpwuid() are stubs that
report ENOENT, so the first g_get_user_name(), g_get_real_name() or
g_get_home_dir() without HOME warned that the user id was unknown, a
fatal warning in tests. WebAssembly now skips the lookup and uses the
fallbacks the lookup's failure led to anyway: "somebody" and "Unknown",
and no home directory from the user database.

Upstream-Status: Inappropriate [Wasm-specific]
---
 glib/gutils.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/glib/gutils.c b/glib/gutils.c
index 9325c1f9a..9b8750e36 100644
--- a/glib/gutils.c
+++ b/glib/gutils.c
@@ -659,7 +659,9 @@ g_get_user_database_entry (void)
     {
       static UserDatabaseEntry e;
 
-#ifdef G_OS_UNIX
+      /* Emscripten's user database functions are stubs that find no one,
+       * so looking the user up would only ever warn. */
+#if defined(G_OS_UNIX) && !defined(G_PLATFORM_WASM)
       {
         struct passwd *pw = NULL;
         gpointer buffer = NULL;
@@ -759,7 +761,7 @@ g_get_user_database_entry (void)
         g_free (buffer);
       }
 
-#endif /* G_OS_UNIX */
+#endif /* G_OS_UNIX && !G_PLATFORM_WASM */
 
 #ifdef G_OS_WIN32
       {
