From 6deaf15a24962fe73c4e29b087960d533e3b5b4f Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 21:26:27 -0700
Subject: [PATCH 36/37] meson: Don't take RTLD_NEXT for usable on Emscripten

Emscripten's dlfcn.h defines RTLD_NEXT, so HAVE_RTLD_NEXT was set, but
dlsym(RTLD_NEXT, ...) finds nothing there: in a static link dlsym() fails
for every handle, and with dynamic linking RTLD_NEXT is unsupported (and
aborts). Only tests use it, to call through to the function they wrap.

Upstream-Status: Inappropriate [Wasm-specific]
---
 meson.build | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 25274dffd..2781bf8df 100644
--- a/meson.build
+++ b/meson.build
@@ -964,7 +964,10 @@ if cc.has_header_symbol('dlfcn.h', 'RTLD_GLOBAL')
 endif
 
 have_rtld_next = false
-if cc.has_header_symbol('dlfcn.h', 'RTLD_NEXT', args: '-D_GNU_SOURCE')
+# Emscripten's dlfcn.h defines RTLD_NEXT, but its dlsym() never finds a next
+# definition: a static link has no dynamic linker to ask, and with dynamic
+# linking RTLD_NEXT isn't supported.
+if host_system != 'emscripten' and cc.has_header_symbol('dlfcn.h', 'RTLD_NEXT', args: '-D_GNU_SOURCE')
   have_rtld_next = true
   glib_conf.set('HAVE_RTLD_NEXT', 1)
 endif
