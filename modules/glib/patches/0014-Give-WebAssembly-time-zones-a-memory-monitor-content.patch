+/* A page has no zoneinfo files, but JavaScript's Intl API knows every IANA
+ * zone, so the data a TZif file would hold is synthesized from it and handed
+ * to the usual TZif parser.
+ *
+ * Offsets are read to the second from the local time Intl formats for an
+ * instant, sampled weekly from 1800, when every zone was still on local mean
+ * time, to 2101, with each change narrowed down to the second; two changes
+ * less than a week apart that cancel out are missed.  Transitions up to 2100
+ * are listed.  After that the footer carries on with the 2090s' pattern as a
+ * POSIX TZ rule, when it is one: a fixed offset, or one change to daylight
+ * saving time and one back each year on a month-week-weekday date.  Zones
+ * whose pattern isn't (Chile's, which change on the first Sunday on or after
+ * the 2nd) keep their last offset instead.
+ *
+ * A period counts as daylight saving time when its offset is above the
+ * lowest offset in both the year before and the year after it began, so
+ * that a zone moving to a new standard offset for good isn't taken for one
+ * in permanent summer time; war time that lasted over a year counts as
+ * standard time.  Abbreviations are Intl's short English names where they
+ * are alphabetic ("PST"), which it only has for some zones and only since
+ * 1970; elsewhere they are numeric ("+0100"), or "UTC" for a zero offset,
+ * where tzdata often has a name ("CET") or "LMT". */
+EM_JS_DEPS (gtimezone, "$UTF8ToString,$stringToUTF8,$lengthBytesUTF8");
+
+/* Returns the data's length, or 0 for a zone Intl doesn't know, and keeps
+ * the data for zone_info_take_intl() on the same thread: Emscripten can't
+ * make malloc() callable from here when only JavaScript code needs it. */
+EM_JS (size_t, zone_info_from_intl, (const char *identifier), {
+  const timeZone = UTF8ToString(identifier);
+  let clock;
+  let names;
+  try {
+    clock = new Intl.DateTimeFormat("en-US", {
+      timeZone, hourCycle: "h23", year: "numeric", month: "numeric",
+      day: "numeric", hour: "numeric", minute: "numeric", second: "numeric",
+    });
+    names = new Intl.DateTimeFormat("en-US", { timeZone, timeZoneName: "short" });
+  } catch {
+    return 0;
+  }
+
+  const offsetAt = (t) => {
+    const p = Object.fromEntries(clock.formatToParts(t * 1000).map(({ type, value }) => [type, value]));
+    return Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second) / 1000 - t;
+  };
+  const two = (n) => String(n).padStart(2, "0");
+  const nameAt = (t, offset) => {
+    const name = names.formatToParts(t * 1000).find(({ type }) => type === "timeZoneName")?.value;
+    if (name && /^[A-Za-z]+$/.test(name))
+      return name;
+    if (offset === 0)
+      return "UTC";
+    const a = Math.abs(offset);
+    const hhmm = `${offset < 0 ? "-" : "+"}${two(Math.floor(a / 3600))}${two(Math.floor(a / 60) % 60)}`;
+    return a % 60 ? hhmm + two(a % 60) : hhmm;
+  };
+  const yearStart = (y) => Date.UTC(y, 0, 1) / 1000;
+
+  const step = 7 * 86400;
+  const year = 365 * 86400;
+  const listed = yearStart(2100);
+  const periods = [{ start: yearStart(1800), offset: offsetAt(yearStart(1800)) }];
+  for (let t = periods[0].start + step; t <= yearStart(2101); t += step) {
+    let low = t - step;
+    let offset = periods.at(-1).offset;
+    while (offsetAt(t) !== offset) {
+      let high = t;
+      while (high - low > 1) {
+        const mid = Math.floor((low + high) / 2);
+        if (offsetAt(mid) === offset)
+          low = mid;
+        else
+          high = mid;
+      }
+      offset = offsetAt(high);
+      periods.push({ start: high, offset });
+      low = high;
+    }
+  }
+
+  const lowest = (from, to) => Math.min(...periods
+    .filter(({ start }, i) => start < to && (periods[i + 1]?.start ?? Infinity) > from)
+    .map(({ offset }) => offset));
+  const types = [];
+  let chars = "";
+  for (const [i, period] of periods.entries()) {
+    if (period.start >= listed)
+      break;
+    const { start, offset } = period;
+    const dst = i > 0 && offset > lowest(start - year, start) && offset > lowest(start, start + year) ? 1 : 0;
+    const abbrev = nameAt(start, offset);
+    let type = types.find((other) => other.offset === offset && other.dst === dst && other.abbrev === abbrev);
+    if (!type) {
+      let at = chars.indexOf(abbrev + "\0");
+      if (at < 0) {
+        at = chars.length;
+        chars += abbrev + "\0";
+      }
+      type = { index: types.length, offset, dst, abbrev, at };
+      types.push(type);
+    }
+    period.type = type;
+  }
+  const emitted = periods.filter(({ type }) => type);
+  /* TZif indexes types and abbreviations with single bytes. */
+  if (types.length > 256 || chars.length > 255)
+    return 0;
+
+  /* POSIX offsets and times: [-]h[:mm[:ss]], offsets counted west. */
+  const clockTime = (s) => {
+    const a = Math.abs(s);
+    const minutes = a % 3600 ? `:${two(Math.floor(a / 60) % 60)}${a % 60 ? `:${two(a % 60)}` : ""}` : "";
+    return `${s < 0 ? "-" : ""}${Math.floor(a / 3600)}${minutes}`;
+  };
+  const zoneName = ({ abbrev, offset }) => `<${abbrev}>${clockTime(-offset)}`;
+  /* The month-week-weekday date and the local time before a change. */
+  const ruleFor = (i) => {
+    const from = emitted[i - 1].type;
+    const local = new Date((emitted[i].start + from.offset) * 1000);
+    const day = local.getUTCDate();
+    const days = new Date(Date.UTC(local.getUTCFullYear(), local.getUTCMonth() + 1, 0)).getUTCDate();
+    return {
+      month: local.getUTCMonth() + 1,
+      week: day + 7 > days ? 5 : Math.ceil(day / 7),
+      weekday: local.getUTCDay(),
+      time: local.getUTCHours() * 3600 + local.getUTCMinutes() * 60 + local.getUTCSeconds(),
+      from,
+      to: emitted[i].type,
+    };
+  };
+  const happens = ({ month, week, weekday, time, from }, y) => {
+    const first = new Date(Date.UTC(y, month - 1, 1)).getUTCDay();
+    let day = 1 + (weekday - first + 7) % 7 + 7 * (week - 1);
+    if (day > new Date(Date.UTC(y, month, 0)).getUTCDate())
+      day -= 7;
+    return Date.UTC(y, month - 1, day) / 1000 + time - from.offset;
+  };
+  const mwd = ({ month, week, weekday, time }) => `,M${month}.${week}.${weekday}/${clockTime(time)}`;
+  const decade = [...emitted.keys()].filter((i) => i > 0 && emitted[i].start >= yearStart(2090));
+  let footer = "";
+  if (decade.length === 0) {
+    footer = zoneName(emitted.at(-1).type);
+  } else if (decade.length === 20) {
+    const rules = [ruleFor(decade[0]), ruleFor(decade[1])];
+    const [start, end] = rules[0].to.dst ? rules : [rules[1], rules[0]];
+    const fits = start.to.dst && !end.to.dst && start.from === end.to && end.from === start.to &&
+      decade.every((i, k) => {
+        const rule = rules[k % 2];
+        return emitted[i].type === rule.to &&
+          happens(rule, new Date(emitted[i].start * 1000).getUTCFullYear()) === emitted[i].start;
+      });
+    if (fits)
+      footer = `${zoneName(end.to)}${zoneName(start.to)}${mwd(start)}${mwd(end)}`;
+  }
+
+  /* Version 2 data; the version 1 block, which readers of version 2 skip,
+   * holds only the first type. */
+  const count = emitted.length - 1;
+  const firstAbbrev = chars.indexOf("\0") + 1;
+  const v1 = 44 + 6 + firstAbbrev;
+  const bytes = new Uint8Array(v1 + 44 + 9 * count + 6 * types.length + chars.length + footer.length + 2);
+  const view = new DataView(bytes.buffer);
+  const header = (at, counts) => {
+    bytes.set([..."TZif2"].map((c) => c.charCodeAt(0)), at);
+    counts.forEach((n, i) => view.setUint32(at + 20 + 4 * i, n));
+    return at + 44;
+  };
+  const ttinfo = (at, { offset, dst, at: abbrevAt }) => {
+    view.setInt32(at, offset);
+    bytes[at + 4] = dst;
+    bytes[at + 5] = abbrevAt;
+  };
+  const ascii = (at, text) => bytes.set([...text].map((c) => c.charCodeAt(0)), at);
+  let at = header(0, [0, 0, 0, 0, 1, firstAbbrev]);
+  ttinfo(at, types[0]);
+  ascii(at + 6, chars.slice(0, firstAbbrev - 1));
+  at = header(v1, [0, 0, 0, count, types.length, chars.length]);
+  for (const [j, { start, type }] of emitted.slice(1).entries()) {
+    view.setBigInt64(at + 8 * j, BigInt(start));
+    bytes[at + 8 * count + j] = type.index;
+  }
+  at += 9 * count;
+  for (const type of types) {
+    ttinfo(at, type);
+    at += 6;
+  }
+  ascii(at, chars);
+  ascii(at + chars.length, "\n" + footer + "\n");
+
+  Module.gTimeZoneData = bytes;
+  return bytes.length;
+});
+
+EM_JS (void, zone_info_take_intl, (guint8 *data), {
+  HEAPU8.set(Module.gTimeZoneData, data);
+  delete Module.gTimeZoneData;
+});
+
+/* Writes the zone's identifier, and returns its length, or 0 if Intl has
+ * none to give. */
+EM_JS (int, zone_identifier_from_intl, (char *buffer, int size), {
+  let timeZone;
+  try {
+    ({ timeZone } = Intl.DateTimeFormat().resolvedOptions());
+  } catch {
+    return 0;
+  }
+  if (!timeZone)
+    return 0;
+  stringToUTF8(timeZone, buffer, size);
+  return lengthBytesUTF8(timeZone);
+});
+
+/* Writes Intl's spelling of a zone name it accepts regardless of case, and
+ * returns its length; 0 if it doesn't know the zone, or knows it by another
+ * name.  Intl maps aliases to other zones' names (Asia/Kolkata to
+ * Asia/Calcutta, US/Pacific to America/Los_Angeles), which callers asking
+ * for one zone by name don't expect back, so only case is corrected. */
+EM_JS (int, zone_identifier_canonical_from_intl, (const char *identifier, char *buffer, int size), {
+  const requested = UTF8ToString(identifier);
+  let timeZone;
+  try {
+    ({ timeZone } = new Intl.DateTimeFormat("en-US", { timeZone: requested }).resolvedOptions());
+  } catch {
+    return 0;
+  }
+  if (timeZone?.toLowerCase() !== requested.toLowerCase())
+    return 0;
+  stringToUTF8(timeZone, buffer, size);
+  return lengthBytesUTF8(timeZone);
+});
+
+static gchar *
+zone_identifier_unix (void)
+{
+  char buffer[256];
+  int length = zone_identifier_from_intl (buffer, sizeof buffer);
+
+  return length > 0 && length < (int) sizeof buffer ? g_strdup (buffer) : NULL;
+}
+
+/* Intl takes zone names in any case, so "europe/berlin" and
+ * "Europe/Berlin" are one zone, known by the second. */
+static gchar *
+zone_identifier_canonical (const gchar *identifier)
+{
+  char buffer[256];
+  int length = zone_identifier_canonical_from_intl (identifier, buffer, sizeof buffer);
+
+  return length > 0 && length < (int) sizeof buffer ? g_strdup (buffer) : NULL;
+}
+
+/* Synthesizing a zone takes tens of milliseconds, and GLib forgets a zone
+ * once its last reference goes, so the data is kept for good. */
+G_LOCK_DEFINE_STATIC (intl_zones);
+static GHashTable *intl_zones = NULL;
+
+static GBytes *
+zone_info_unix (const gchar *identifier,
+                const gchar *resolved_identifier)
+{
+  GBytes *zoneinfo;
+
+  if (resolved_identifier != NULL)
+    identifier = resolved_identifier;
+  if (identifier == NULL)
+    return NULL;
+  if (*identifier == ':')
+    identifier++;
+
+  G_LOCK (intl_zones);
+
+  if (intl_zones == NULL)
+    intl_zones = g_hash_table_new (g_str_hash, g_str_equal);
+
+  zoneinfo = g_hash_table_lookup (intl_zones, identifier);
+  if (zoneinfo == NULL)
+    {
+      size_t length = zone_info_from_intl (identifier);
+
+      if (length > 0)
+        {
+          guint8 *data = g_malloc (length);
+
+          zone_info_take_intl (data);
+          zoneinfo = g_bytes_new_take (data, length);
+          g_hash_table_insert (intl_zones, g_strdup (identifier), zoneinfo);
+        }
+    }
+
+  G_UNLOCK (intl_zones);
+
+  return zoneinfo != NULL ? g_bytes_ref (zoneinfo) : NULL;
+}
