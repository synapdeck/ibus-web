diff --git a/gobject/gsourceclosure.c b/gobject/gsourceclosure.c
index f4076abdc..c5718d935 100644
--- a/gobject/gsourceclosure.c
+++ b/gobject/gsourceclosure.c
@@ -222,8 +222,17 @@ closure_callback_get (gpointer     cb_data,
   *data = cb_data;
 }
 
+/* g_closure_ref() returns the closure, so calling it through the
+ * void-returning ref type is undefined behaviour, and traps on
+ * WebAssembly. */
+static void
+closure_callback_ref (gpointer cb_data)
+{
+  g_closure_ref (cb_data);
+}
+
 static GSourceCallbackFuncs closure_callback_funcs = {
-  (void (*) (gpointer)) g_closure_ref,
+  closure_callback_ref,
   (void (*) (gpointer)) g_closure_unref,
   closure_callback_get
 };
