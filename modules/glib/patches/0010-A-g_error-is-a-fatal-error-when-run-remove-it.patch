From: Jorge Zapata <jorgeluis.zapata@gmail.com>
Date: Sun, 28 Apr 2024 19:45:06 +0200
Subject: [PATCH 10/36] A g_error is a fatal error when run, remove it

(cherry picked from commit 75de668d369069a91ec90c18d4b39c74e5d4ca3e)
---
 glib/gwakeup.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/glib/gwakeup.c b/glib/gwakeup.c
index 1f6140e00..f5569998d 100644
--- a/glib/gwakeup.c
+++ b/glib/gwakeup.c
@@ -145,7 +145,6 @@ GWakeup *
 g_wakeup_new (void)
 {
 #ifdef G_PLATFORM_WASM
-  g_error ("g_wakeup_new is no-op on WebAssembly");
   return NULL;
 #else
   GError *error = NULL;
@@ -265,9 +264,7 @@ g_wakeup_acknowledge (GWakeup *wakeup)
 void
 g_wakeup_signal (GWakeup *wakeup)
 {
-#ifdef G_PLATFORM_WASM
-  g_error ("g_wakeup_signal is no-op on WebAssembly");
-#else
+#ifndef G_PLATFORM_WASM
   int res;
 
   if (wakeup->fds[1] == -1)
