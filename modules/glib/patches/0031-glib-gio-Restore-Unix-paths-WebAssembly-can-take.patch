From 67f40beda1c4c987c957366545aa5750e3c32d92 Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 17:01:55 -0700
Subject: [PATCH 31/31] glib, gio: Restore Unix paths WebAssembly can take

Three of the paths the WebAssembly port left out work there as they do
on other Unixes:

- g_source_add_unix_fd(), g_source_modify_unix_fd(),
  g_source_remove_unix_fd() and g_source_query_unix_fd() weren't built,
  though gmain.h declares them on every Unix, so callers failed to link.
  They only add fds to the source's poll set, which the main context
  already probes on WebAssembly.

- Local files never got standard::is-hidden or standard::is-backup.
  Dotfiles, names listed in a directory's .hidden file and names ending
  in "~" are now reported as on other Unixes. Lost+found directories,
  which need the Unix mount table, are not looked for.

- Files in a GResource never got a content type. It is guessed from the
  name and data, as for local files.

Upstream-Status: Inappropriate [Wasm-specific]
---
 gio/glocalfileinfo.c | 11 ++++++-----
 gio/gresourcefile.c  |  2 --
 glib/gmain.c         |  4 ++--
 3 files changed, 8 insertions(+), 9 deletions(-)

diff --git a/gio/glocalfileinfo.c b/gio/glocalfileinfo.c
index 69ff59a0d..f626ca244 100644
--- a/gio/glocalfileinfo.c
+++ b/gio/glocalfileinfo.c
@@ -1996,7 +1996,6 @@ _g_local_file_info_get (const char             *basename,
   if (stat_ok)
     set_info_from_stat (info, &statbuf, attribute_matcher);
 
-#ifndef G_PLATFORM_WASM
 #ifndef G_OS_WIN32
   if (_g_file_attribute_matcher_matches_id (attribute_matcher,
 					    G_FILE_ATTRIBUTE_ID_STANDARD_IS_HIDDEN))
@@ -2004,9 +2003,12 @@ _g_local_file_info_get (const char             *basename,
       g_file_info_set_is_hidden (info,
                                  (basename != NULL &&
                                   (basename[0] == '.' ||
-                                   file_is_hidden (path, basename) ||
-                                   (stat_ok &&
-                                    _g_local_file_is_lost_found_dir (path, _g_stat_dev (&statbuf))))));
+                                   file_is_hidden (path, basename)
+#ifndef G_PLATFORM_WASM
+                                   || (stat_ok &&
+                                       _g_local_file_is_lost_found_dir (path, _g_stat_dev (&statbuf)))
+#endif
+                                   )));
     }
 
   _g_file_info_set_attribute_boolean_by_id (info,
@@ -2033,7 +2035,6 @@ _g_local_file_info_get (const char             *basename,
         _g_file_info_set_attribute_uint32_by_id (info, G_FILE_ATTRIBUTE_ID_DOS_REPARSE_POINT_TAG, statbuf.reparse_tag);
     }
 #endif
-#endif /* !G_PLATFORM_WASM */
 
   symlink_target = NULL;
   if (is_symlink)
diff --git a/gio/gresourcefile.c b/gio/gresourcefile.c
index 6ac042204..55f06cbe0 100644
--- a/gio/gresourcefile.c
+++ b/gio/gresourcefile.c
@@ -510,7 +510,6 @@ g_resource_file_query_info (GFile                *file,
       g_file_info_set_file_type (info, G_FILE_TYPE_REGULAR);
       g_file_info_set_size (info, size);
 
-#ifndef G_PLATFORM_WASM
       if ((_g_file_attribute_matcher_matches_id (matcher, G_FILE_ATTRIBUTE_ID_STANDARD_CONTENT_TYPE) ||
            ((~resource_flags & G_RESOURCE_FLAGS_COMPRESSED) && 
             _g_file_attribute_matcher_matches_id (matcher, G_FILE_ATTRIBUTE_ID_STANDARD_FAST_CONTENT_TYPE))) &&
@@ -525,7 +524,6 @@ g_resource_file_query_info (GFile                *file,
           g_bytes_unref (bytes);
         }
       else
-#endif
         content_type = NULL;
 
       if (content_type)
diff --git a/glib/gmain.c b/glib/gmain.c
index f0ced2961..c1c9ff18b 100644
--- a/glib/gmain.c
+++ b/glib/gmain.c
@@ -2810,7 +2810,7 @@ g_clear_handle_id (guint            *tag_ptr,
     }
 }
 
-#if defined(G_OS_UNIX) && !defined(G_PLATFORM_WASM)
+#ifdef G_OS_UNIX
 /**
  * g_source_add_unix_fd:
  * @source: a source
@@ -2995,7 +2995,7 @@ g_source_query_unix_fd (GSource  *source,
 
   return poll_fd->revents;
 }
-#endif /* G_OS_UNIX && !G_PLATFORM_WASM */
+#endif /* G_OS_UNIX */
 
 /**
  * g_get_current_time:
