From 9d41338827625dc213abe54547b50447320d28fd Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 23:36:58 -0700
Subject: [PATCH 15/17] gconvert, gcharsetconverter: Report characters iconv()
 replaces
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Some iconv() implementations, musl's among them, convert a character the
target charset lacks to a replacement ('*' in musl's case) and count it
as an irreversible conversion instead of failing with EILSEQ, and forget
that count when a later character ends the same call with an error
(running out of output room, an incomplete character at the end of the
input, or an invalid one). g_convert() reported such a conversion as an
illegal sequence only when the call that made it succeeded,
g_convert_with_fallback() kept the replacement where the caller asked
for its fallback, and GCharsetConverter neither reported an error nor
used its fallback.

Whether iconv() replaces is probed once, by converting "½" to ASCII.
Where it does:
- GCharsetConverter converts its input a character at a time from the
  start, stopping at a replaced character as at EILSEQ, so the fallback
  replaces it or the error reports it. Nothing is converted twice, so
  this is exact for stateful source charsets too.
- g_convert_with_iconv() starts again from a reset converter when a
  call fails after converting something, with room for all the output
  or with only the complete characters, so that one call converts
  everything and reports the count.

g_convert_with_fallback() starts again once from a reset converter, a
character at a time, when a call reports a replacement (or, where
iconv() replaces, runs out of output room after converting something),
so a stateful target never loses a shift sequence to discarded output.
From then on each character, of the string and of the fallback, is
first converted alone on a second converter reset for it; one that
fails or is replaced there is treated as EILSEQ, so the fallback
replaces it or a fallback holding one is refused, and the conversion
stays linear. If the second converter can't be opened, the conversion
fails rather than keep a replacement unreported.

The check assumes the target's encoder is context-independent: whether
a character has a representation doesn't depend on its neighbours or the
shift state. musl's encoders are. glibc's context-dependent ones
(BIG5-HKSCS, TSCII, CP1258's composition) aren't, but they report a
character they lack with EILSEQ and count no replacement, so they never
take that path.

Where iconv() fails with EILSEQ instead, as glibc's does, the only
change is that last restart, which glibc reaches just for irreversible
conversions it counts; a target that asks for transliteration
("//TRANSLIT") still gets iconv()'s replacements.

Upstream-Status: Pending
---
 gio/gcharsetconverter.c |  99 +++++++++++++++++++++++
 glib/gconvert.c         | 174 +++++++++++++++++++++++++++++++++++++++-
 2 files changed, 270 insertions(+), 3 deletions(-)

diff --git a/gio/gcharsetconverter.c b/gio/gcharsetconverter.c
index c8944f3a3..1219425a0 100644
--- a/gio/gcharsetconverter.c
+++ b/gio/gcharsetconverter.c
@@ -25,6 +25,7 @@
 #include "gcharsetconverter.h"
 
 #include <errno.h>
+#include <string.h>
 
 #include "ginitable.h"
 #include "gioerror.h"
@@ -247,6 +248,93 @@ g_charset_converter_reset (GConverter *converter)
   conv->n_fallback_errors = 0;
 }
 
+/* Whether iconv() converts a character the target charset lacks to a
+ * replacement and counts it as an irreversible conversion, as musl's does,
+ * rather than failing with EILSEQ.  Such an iconv() forgets the count when a
+ * later character ends the call with an error, so a call that fails after
+ * converting something may have replaced a character too. */
+static gboolean
+iconv_replaces_unrepresentable (void)
+{
+  static gsize replaces = 0;
+
+  if (g_once_init_enter (&replaces))
+    {
+      GIConv cd = g_iconv_open ("ASCII", "UTF-8");
+      gsize result = 1;
+
+      if (cd != (GIConv) -1)
+        {
+          gchar in[] = "\xc2\xbd";
+          gchar out[8];
+          gchar *inp = in, *outp = out;
+          gsize in_left = 2, out_left = sizeof out;
+
+          if (g_iconv (cd, &inp, &in_left, &outp, &out_left) != (gsize) -1)
+            result = 2;
+          g_iconv_close (cd);
+        }
+
+      g_once_init_leave (&replaces, result);
+    }
+
+  return replaces == 2;
+}
+
+/* Converts a character at a time, up to the first one iconv() converts
+ * irreversibly, and fails there with EILSEQ.  Returns 0 once all the input
+ * is converted, or -1 with errno set where it stopped. */
+static gsize
+convert_reversibly (GIConv   cd,
+                    gchar  **inbuf,
+                    gsize   *inbytes_left,
+                    gchar  **outbuf,
+                    gsize   *outbytes_left)
+{
+  while (*inbytes_left > 0)
+    {
+      gchar *in = NULL, *out = NULL;
+      gsize in_size, in_left, out_left = 0;
+      gsize res = (gsize) -1;
+      int errsv = 0;
+
+      /* The shortest input iconv() takes is one whole character.  A call
+       * that consumes a shift sequence or byte order mark before running out
+       * of input has changed the converter's state, so what it consumed
+       * stays consumed. */
+      for (in_size = 1; in_size <= *inbytes_left; in_size++)
+        {
+          in = *inbuf;
+          in_left = in_size;
+          out = *outbuf;
+          out_left = *outbytes_left;
+          res = g_iconv (cd, &in, &in_left, &out, &out_left);
+          errsv = errno;
+          if (res != (gsize) -1 || errsv != EINVAL || in != *inbuf)
+            break;
+        }
+
+      if (res != (gsize) -1 && res != 0)
+        {
+          errno = EILSEQ;
+          return (gsize) -1;
+        }
+
+      if (res == (gsize) -1 && in == *inbuf)
+        {
+          errno = errsv;
+          return res;
+        }
+
+      *inbytes_left -= (gsize) (in - *inbuf);
+      *inbuf = in;
+      *outbuf = out;
+      *outbytes_left = out_left;
+    }
+
+  return 0;
+}
+
 static GConverterResult
 g_charset_converter_convert (GConverter       *converter,
 			     const void       *inbuf,
@@ -302,6 +390,17 @@ g_charset_converter_convert (GConverter       *converter,
     res = g_iconv (conv->iconv,
                    NULL, &in_left,
                    &outbufp, &out_left);
+  /* Some iconv() implementations, musl's among them, write a replacement for
+   * a character the target charset lacks and count it as an irreversible
+   * conversion instead of failing with EILSEQ, and forget the count when a
+   * later character ends the call with an error.  Converted a character at
+   * a time, the input stops at that character, so it is reported, or
+   * replaced by the fallback, as EILSEQ would have it.  A target that asks
+   * for transliteration ("//TRANSLIT") gets its replacements on purpose. */
+  else if (strstr (conv->to, "//") == NULL && iconv_replaces_unrepresentable ())
+    res = convert_reversibly (conv->iconv,
+                              &inbufp, &in_left,
+                              &outbufp, &out_left);
   else
     res = g_iconv (conv->iconv,
                    &inbufp, &in_left,
diff --git a/glib/gconvert.c b/glib/gconvert.c
index f10aeffde..059e46acc 100644
--- a/glib/gconvert.c
+++ b/glib/gconvert.c
@@ -212,6 +212,55 @@ g_iconv_close (GIConv converter)
   return iconv_close (cd);
 }
 
+/* Whether iconv() converts a character the target charset lacks to a
+ * replacement and counts it as an irreversible conversion, as musl's does,
+ * rather than failing with EILSEQ.  Such an iconv() forgets the count when a
+ * later character ends the call with an error, so a call that fails after
+ * converting something may have replaced a character too. */
+static gboolean
+iconv_replaces_unrepresentable (void)
+{
+  static gsize replaces = 0;
+
+  if (g_once_init_enter (&replaces))
+    {
+      GIConv cd = g_iconv_open ("ASCII", "UTF-8");
+      gsize result = 1;
+
+      if (cd != (GIConv) -1)
+        {
+          gchar in[] = "\xc2\xbd";
+          gchar out[8];
+          gchar *inp = in, *outp = out;
+          gsize in_left = 2, out_left = sizeof out;
+
+          if (g_iconv (cd, &inp, &in_left, &outp, &out_left) != (gsize) -1)
+            result = 2;
+          g_iconv_close (cd);
+        }
+
+      g_once_init_leave (&replaces, result);
+    }
+
+  return replaces == 2;
+}
+
+/* Whether @cd converts the @len bytes at @p, one character, without failing
+ * or replacing it.  @cd is reset first, so its shift state doesn't matter;
+ * whether a character has a representation doesn't depend on it. */
+static gboolean
+converts_reversibly (GIConv       cd,
+                     const gchar *p,
+                     gsize        len)
+{
+  gchar buf[64];
+  gchar *in = (gchar *) p, *out = buf;
+  gsize in_left = len, out_left = sizeof buf;
+
+  g_iconv (cd, NULL, NULL, NULL, NULL);
+  return g_iconv (cd, &in, &in_left, &out, &out_left) == 0;
+}
+
 static GIConv
 open_converter (const gchar *to_codeset,
 		const gchar *from_codeset,
@@ -314,6 +363,7 @@ g_convert_with_iconv (const gchar *str,
   gboolean have_error = FALSE;
   gboolean done = FALSE;
   gboolean reset = FALSE;
+  gsize limit;
   
   g_return_val_if_fail (converter != (GIConv) -1, NULL);
      
@@ -321,6 +371,7 @@ g_convert_with_iconv (const gchar *str,
     len = strlen (str);
 
   p = str;
+  limit = len;
   inbytes_remaining = len;
   outbuf_size = len + NUL_TERMINATOR_LENGTH;
   
@@ -329,11 +380,45 @@ g_convert_with_iconv (const gchar *str,
 
   while (!done && !have_error)
     {
+      const gchar *p_start = p;
+
       if (reset)
         err = g_iconv (converter, NULL, &inbytes_remaining, &outp, &outbytes_remaining);
       else
         err = g_iconv (converter, (char **)&p, &inbytes_remaining, &outp, &outbytes_remaining);
 
+      /* A call that runs out of room for the output, or ends in an
+       * incomplete character, after converting something may have lost the
+       * count of characters it replaced.  Start again from a reset
+       * converter, with room for all the output, or with only the complete
+       * characters, so that one call converts them all and reports the
+       * count. */
+      if (err == (gsize) -1 && !reset && p != p_start)
+        {
+          int errsv = errno;
+
+          if ((errsv == E2BIG || errsv == EINVAL) &&
+              iconv_replaces_unrepresentable ())
+            {
+              if (errsv == E2BIG)
+                {
+                  outbuf_size *= 2;
+                  dest = g_realloc (dest, outbuf_size);
+                }
+              else
+                limit = (gsize) (p - str);
+
+              g_iconv (converter, NULL, NULL, NULL, NULL);
+              p = str;
+              inbytes_remaining = limit;
+              outp = dest;
+              outbytes_remaining = outbuf_size - NUL_TERMINATOR_LENGTH;
+              continue;
+            }
+
+          errno = errsv;
+        }
+
       if (err == (gsize) -1)
 	{
 	  switch (errno)
@@ -572,6 +657,9 @@ g_convert_with_fallback (const gchar *str,
   gsize outbuf_size;
   gboolean have_error = FALSE;
   gboolean done = FALSE;
+  gboolean by_char = FALSE;
+  gsize utf8_len;
+  GIConv check_cd = (GIConv) -1;
 
   GError *local_error = NULL;
   
@@ -627,6 +715,8 @@ g_convert_with_fallback (const gchar *str,
       return NULL;
     }
 
+  utf8_len = inbytes_remaining;
+
   /* Now the heart of the code. We loop through the UTF-8 string, and
    * whenever we hit an offending character, we form fallback, convert
    * the fallback to the target codeset, and then go back to
@@ -643,9 +733,81 @@ g_convert_with_fallback (const gchar *str,
 
   while (!done && !have_error)
     {
+      const gchar *p_start = p;
+      gchar *outp_start = outp;
+      gsize inbytes_start = inbytes_remaining;
+      gsize outbytes_start = outbytes_remaining;
       gsize inbytes_tmp = inbytes_remaining;
-      err = g_iconv (cd, (char **)&p, &inbytes_tmp, &outp, &outbytes_remaining);
-      inbytes_remaining = inbytes_tmp;
+
+      if (by_char && p)
+        inbytes_tmp = MIN (inbytes_remaining, (gsize) (g_utf8_next_char (p) - p));
+
+      if (by_char && p && !converts_reversibly (check_cd, p, inbytes_tmp))
+        {
+          err = (gsize) -1;
+          errno = EILSEQ;
+        }
+      else
+        {
+          err = g_iconv (cd, (char **)&p, &inbytes_tmp, &outp, &outbytes_remaining);
+          if (p_start)
+            inbytes_remaining = inbytes_start - (gsize) (p - p_start);
+          else
+            inbytes_remaining = inbytes_tmp;
+        }
+
+      /* Some iconv() implementations, musl's among them, write a replacement
+       * for a character the target codeset lacks and count it as an
+       * irreversible conversion instead of failing with EILSEQ, and forget
+       * the count when the same call runs out of room for the output.  Then
+       * the string is converted again, a character at a time, from a reset
+       * converter, since the output discarded may have changed a stateful
+       * target's shift state.  Each character is first converted alone on a
+       * second converter, and one that converts irreversibly there is
+       * treated as EILSEQ, so the fallback replaces it.  A target that asks
+       * for transliteration ("//TRANSLIT") gets its replacements on
+       * purpose. */
+      if (!by_char && p_start && !save_p && strstr (to_codeset, "//") == NULL)
+        {
+          int errsv = errno;
+
+          if ((err != (gsize) -1 && err != 0) ||
+              (err == (gsize) -1 && errsv == E2BIG && p != p_start &&
+               iconv_replaces_unrepresentable ()))
+            {
+              /* Without the second converter a replacement would go
+               * through unreported. */
+              check_cd = open_converter (to_codeset, "UTF-8", error);
+              if (check_cd == (GIConv) -1)
+                {
+                  have_error = TRUE;
+                  break;
+                }
+
+              g_iconv (cd, NULL, NULL, NULL, NULL);
+              p = utf8;
+              inbytes_remaining = utf8_len;
+              outp = dest;
+              outbytes_remaining = outbuf_size - NUL_TERMINATOR_LENGTH;
+              by_char = TRUE;
+              continue;
+            }
+
+          errno = errsv;
+        }
+
+      /* A character converted alone, or a fallback converted in one call,
+       * that comes back replaced is one the target lacks. */
+      if (err != (gsize) -1 && err != 0 && (by_char || save_p) &&
+          strstr (to_codeset, "//") == NULL)
+        {
+          p = p_start;
+          outp = outp_start;
+          inbytes_remaining = inbytes_start;
+          outbytes_remaining = outbytes_start;
+          err = (gsize) -1;
+          errno = EILSEQ;
+        }
 
       if (err == (gsize) -1)
 	{
@@ -711,7 +873,11 @@ g_convert_with_fallback (const gchar *str,
 	}
       else
 	{
-	  if (save_p)
+	  if (p && inbytes_remaining > 0)
+	    {
+	      /* Converting a character at a time; go on with the next. */
+	    }
+	  else if (save_p)
 	    {
 	      if (!fallback)
 		g_free ((gchar *)insert_str);
@@ -740,6 +906,8 @@ g_convert_with_fallback (const gchar *str,
     *bytes_written = outp - dest;	/* Doesn't include '\0' */
 
   g_free (utf8);
+  if (check_cd != (GIConv) -1)
+    g_iconv_close (check_cd);
 
   if (have_error)
     {
