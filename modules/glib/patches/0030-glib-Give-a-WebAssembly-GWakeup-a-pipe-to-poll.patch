From 0ca6f44b7a61b2d2ff3d22cd0fe2a86e57eb6de7 Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 17:01:08 -0700
Subject: [PATCH 30/31] glib: Give a WebAssembly GWakeup a pipe to poll

g_wakeup_get_pollfd() aborted on WebAssembly, where a GWakeup is a
futex, so g_cancellable_make_pollfd() and g_cancellable_get_fd() did
too, and with them everything that polls a cancellable's fd.

The first g_wakeup_get_pollfd() on a wakeup now creates a pipe and
returns its read end. From then on g_wakeup_signal() also writes a byte
to it and g_wakeup_acknowledge() drains it before acknowledging the
futex, so the fd polls ready whenever the futex is signalled. Waiting
is unchanged: g_wakeup_wait() and main contexts still sleep on the
futex, and main contexts never ask for the fd, so they never get a pipe.
The drain stops at the first read that returns nothing, which is EAGAIN
on Emscripten's JavaScript file systems (even at end of file) and 0 on
WasmFS.

g_poll() with a timeout didn't wait on WebAssembly either: Emscripten's
poll() ignores the timeout on the main thread and on WasmFS, and from a
pthread on the JavaScript file systems it waits for the main thread to
return to its event loop. It now probes the fds without waiting and
sleeps in 10 ms slices between probes until one is ready or the timeout
passes.

gwakeuptest checks the poll fd again, and that it agrees with the
futex.

Upstream-Status: Inappropriate [Wasm-specific]
---
 glib/gpoll.c             | 52 +++++++++++++++++++++++
 glib/gwakeup.c           | 92 +++++++++++++++++++++++++++++++++++++---
 glib/tests/gwakeuptest.c | 12 +++---
 3 files changed, 145 insertions(+), 11 deletions(-)

diff --git a/glib/gpoll.c b/glib/gpoll.c
index 293e7111a..208c34ca9 100644
--- a/glib/gpoll.c
+++ b/glib/gpoll.c
@@ -93,6 +93,54 @@ extern gboolean _g_main_poll_debug;
 
 #ifdef HAVE_POLL
 
+#ifdef G_PLATFORM_WASM
+#include "gdatetime.h"
+#include "gmain.h"
+#include "gtimer.h"
+
+/* Between probes of the fds.  Each probe from a pthread is a call proxied
+ * to the main thread, so this bounds both how late a ready fd is noticed
+ * and how often the main thread is interrupted. */
+#define WASM_POLL_SLICE_USEC (10 * G_TIME_SPAN_MILLISECOND)
+
+/* Emscripten's poll() can't wait.  On the main thread, and on WasmFS
+ * anywhere, it ignores the timeout; from a pthread on the JavaScript file
+ * systems it is proxied to the main thread, where a wait only ends once
+ * that thread returns to its event loop, which a thread blocked in GLib
+ * never does.  So the fds are only ever probed, with sleeps in between
+ * until one is ready or the timeout passes. */
+static gint
+g_poll_wasm (GPollFD *fds,
+             guint    nfds,
+             gint     timeout)
+{
+  gint64 deadline = -1;
+
+  if (timeout > 0)
+    deadline = g_get_monotonic_time () + timeout * G_TIME_SPAN_MILLISECOND;
+
+  for (;;)
+    {
+      gint64 sleep_usec = WASM_POLL_SLICE_USEC;
+      gint ret = poll ((struct pollfd *) fds, nfds, 0);
+
+      if (ret != 0 || timeout == 0)
+        return ret;
+
+      if (deadline >= 0)
+        {
+          gint64 remaining = deadline - g_get_monotonic_time ();
+
+          if (remaining <= 0)
+            return 0;
+          sleep_usec = MIN (sleep_usec, remaining);
+        }
+
+      g_usleep (sleep_usec);
+    }
+}
+#endif
+
 /**
  * g_poll:
  * @fds: file descriptors to poll
@@ -128,7 +176,11 @@ g_poll (GPollFD *fds,
 	guint    nfds,
 	gint     timeout)
 {
+#ifdef G_PLATFORM_WASM
+  return g_poll_wasm (fds, nfds, timeout);
+#else
   return poll ((struct pollfd *)fds, nfds, timeout);
+#endif
 }
 
 #else	/* !HAVE_POLL */
diff --git a/glib/gwakeup.c b/glib/gwakeup.c
index c503ec4bc..c66635f16 100644
--- a/glib/gwakeup.c
+++ b/glib/gwakeup.c
@@ -113,12 +113,18 @@ g_wakeup_free (GWakeup *wakeup)
 #ifdef G_PLATFORM_WASM
 #ifdef GLIB_COMPILATION
 #include "gatomic.h"
+#include "giochannel.h"
+#include "gmem.h"
 #include "gmessages.h"
 #include "gslice.h"
+#include "gstrfuncs.h"
 #endif
 #include <emscripten/threading.h>
+#include <errno.h>
+#include <fcntl.h>
 #include <limits.h>
 #include <math.h>
+#include <unistd.h>
 #else /* !G_PLATFORM_WASM */
 #include "glib-unix.h"
 #include <fcntl.h>
@@ -128,15 +134,21 @@ g_wakeup_free (GWakeup *wakeup)
 #endif
 #endif /*G_PLATFORM_WASM*/
 
-/* There are no file descriptors to signal through on WebAssembly, so a
- * wakeup is a futex: signalling bumps @signals and wakes its waiters, and
+/* Emscripten's poll() can't wait on a file descriptor, so on WebAssembly
+ * a wakeup is a futex: signalling bumps @signals and wakes its waiters, and
  * g_wakeup_wait() sleeps while @signals still equals the value last
- * acknowledged.  Only equality is compared, so the counter may wrap. */
+ * acknowledged.  Only equality is compared, so the counter may wrap.
+ *
+ * Callers that need something to poll (GCancellable's fds) get a pipe,
+ * created by the first g_wakeup_get_pollfd(): from then on each signal
+ * also writes a byte to it, and acknowledging drains it.  Wakeups nobody
+ * polls, such as every GMainContext's, never create one. */
 struct _GWakeup
 {
 #ifdef G_PLATFORM_WASM
   gint signals;       /* (atomic) */
   gint acknowledged;  /* (atomic) */
+  gint *pipe;         /* (atomic) (nullable): read end, then write end */
 #else
   gint fds[2];
 #endif
@@ -209,8 +221,39 @@ g_wakeup_get_pollfd (GWakeup *wakeup,
                      GPollFD *poll_fd)
 {
 #ifdef G_PLATFORM_WASM
-  /* Nothing can poll a futex; see g_wakeup_wait(). */
-  g_error ("g_wakeup_get_pollfd is not supported on WebAssembly");
+  gint *fds = g_atomic_pointer_get (&wakeup->pipe);
+
+  if (fds == NULL)
+    {
+      fds = g_new (gint, 2);
+
+      /* WasmFS's pipe2() takes no flag but O_CLOEXEC. */
+      if (pipe2 (fds, O_CLOEXEC) != 0)
+        g_error ("Creating pipes for GWakeup: %s", g_strerror (errno));
+      fcntl (fds[0], F_SETFL, O_NONBLOCK);
+      fcntl (fds[1], F_SETFL, O_NONBLOCK);
+
+      if (g_atomic_pointer_compare_and_exchange (&wakeup->pipe, NULL, fds))
+        {
+          uint8_t one = 1;
+
+          /* A signal racing with the publication above either saw the
+           * pipe and wrote to it, or bumped the counter before this reads
+           * it; a spare byte only costs a spurious wakeup. */
+          if (g_atomic_int_get (&wakeup->signals) != g_atomic_int_get (&wakeup->acknowledged))
+            (void) write (fds[1], &one, sizeof one);
+        }
+      else
+        {
+          close (fds[0]);
+          close (fds[1]);
+          g_free (fds);
+          fds = g_atomic_pointer_get (&wakeup->pipe);
+        }
+    }
+
+  poll_fd->fd = fds[0];
+  poll_fd->events = G_IO_IN;
 #else
   poll_fd->fd = wakeup->fds[0];
   poll_fd->events = G_IO_IN;
@@ -235,6 +278,23 @@ void
 g_wakeup_acknowledge (GWakeup *wakeup)
 {
 #ifdef G_PLATFORM_WASM
+  gint *fds = g_atomic_pointer_get (&wakeup->pipe);
+
+  /* Draining first means a signal landing in between leaves a byte
+   * behind, a spurious wakeup, rather than a signalled wakeup whose fd
+   * doesn't poll ready.  An empty pipe reads as EAGAIN on Emscripten's
+   * JavaScript file systems, even once every writer has closed, and as 0
+   * on WasmFS; either ends the loop. */
+  if (fds != NULL)
+    {
+      uint8_t buffer[64];
+      int res;
+
+      do
+        res = read (fds[0], buffer, sizeof buffer);
+      while (res > 0 || G_UNLIKELY (res == -1 && errno == EINTR));
+    }
+
   g_atomic_int_set (&wakeup->acknowledged, g_atomic_int_get (&wakeup->signals));
 #else
   int res;
@@ -278,8 +338,21 @@ void
 g_wakeup_signal (GWakeup *wakeup)
 {
 #ifdef G_PLATFORM_WASM
+  gint *fds;
+
   g_atomic_int_inc (&wakeup->signals);
   emscripten_futex_wake (&wakeup->signals, INT_MAX);
+
+  fds = g_atomic_pointer_get (&wakeup->pipe);
+  if (fds != NULL)
+    {
+      uint8_t one = 1;
+      int res;
+
+      do
+        res = write (fds[1], &one, sizeof one);
+      while (G_UNLIKELY (res == -1 && errno == EINTR));
+    }
 #else
   int res;
 
@@ -318,7 +391,14 @@ g_wakeup_signal (GWakeup *wakeup)
 void
 g_wakeup_free (GWakeup *wakeup)
 {
-#ifndef G_PLATFORM_WASM
+#ifdef G_PLATFORM_WASM
+  if (wakeup->pipe != NULL)
+    {
+      close (wakeup->pipe[0]);
+      close (wakeup->pipe[1]);
+      g_free (wakeup->pipe);
+    }
+#else
   close (wakeup->fds[0]);
 
   if (wakeup->fds[1] != -1)
diff --git a/glib/tests/gwakeuptest.c b/glib/tests/gwakeuptest.c
index dbd87bdee..d993f128b 100644
--- a/glib/tests/gwakeuptest.c
+++ b/glib/tests/gwakeuptest.c
@@ -1,18 +1,20 @@
 #include <glib.h>
 #include <glib/gwakeup.h>
 
-/* A WebAssembly wakeup has no fd to poll; it is waited on directly. */
+/* On WebAssembly a wakeup is waited on directly, and its poll fd, a pipe,
+ * only mirrors it, so checks compare the two. */
 static gboolean
 check_signaled (GWakeup *wakeup)
 {
-#ifdef G_PLATFORM_WASM
-  return g_wakeup_wait (wakeup, 0);
-#else
   GPollFD fd;
+  gboolean polled;
 
   g_wakeup_get_pollfd (wakeup, &fd);
-  return g_poll (&fd, 1, 0);
+  polled = g_poll (&fd, 1, 0);
+#ifdef G_PLATFORM_WASM
+  g_assert_cmpint (polled, ==, g_wakeup_wait (wakeup, 0));
 #endif
+  return polled;
 }
 
 static void
