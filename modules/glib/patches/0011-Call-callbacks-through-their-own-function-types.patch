diff --git a/gio/gcancellable.c b/gio/gcancellable.c
index 44b8bc463..12c6274f7 100644
--- a/gio/gcancellable.c
+++ b/gio/gcancellable.c
@@ -64,6 +64,34 @@ G_DEFINE_TYPE_WITH_PRIVATE (GCancellable, g_cancellable, G_TYPE_OBJECT)
 static GPrivate current_cancellable;
 static GCond cancellable_cond;
 
+/* Passing a #GDestroyNotify to g_cclosure_new() directly would call it as
+ * a two-argument #GClosureNotify, which is undefined behaviour, and traps
+ * on WebAssembly. The closure's own data can't carry it: finalize
+ * notifiers see their notify data in closure->data. */
+typedef struct
+{
+  GDestroyNotify destroy_func;
+  gpointer data;
+} ClosureDestroyData;
+
+static void
+closure_destroy_data (gpointer  notify_data,
+                      GClosure *closure)
+{
+  ClosureDestroyData *destroy_data = notify_data;
+
+  destroy_data->destroy_func (destroy_data->data);
+  g_free (destroy_data);
+}
+
+/* g_free() as a #GClosureNotify, for the same reason. */
+static void
+closure_free_data (gpointer  data,
+                   GClosure *closure)
+{
+  g_free (data);
+}
+
 static void
 g_cancellable_finalize (GObject *object)
 {
@@ -640,9 +668,19 @@ g_cancellable_connect (GCancellable   *cancellable,
   else
     {
       GClosure *closure;
+      ClosureDestroyData *destroy_data = NULL;
+
+      if (data_destroy_func != NULL)
+        {
+          destroy_data = g_new (ClosureDestroyData, 1);
+          destroy_data->destroy_func = g_steal_pointer (&data_destroy_func);
+          destroy_data->data = data;
+        }
 
-      closure = g_cclosure_new (callback, g_steal_pointer (&data),
-                                (GClosureNotify) g_steal_pointer (&data_destroy_func));
+      closure = g_cclosure_new (callback, g_steal_pointer (&data), NULL);
+      if (destroy_data != NULL)
+        g_closure_add_finalize_notifier (closure, destroy_data,
+                                         closure_destroy_data);
 
       id = g_signal_connect_closure_by_id (cancellable, signals[CANCELLED],
                                            0, closure, FALSE);
@@ -896,7 +934,7 @@ g_cancellable_source_new (GCancellable *cancellable)
         g_signal_connect_data (cancellable, "cancelled",
                                G_CALLBACK (cancellable_source_cancelled),
                                cancellable_source->self_ptr,
-                               (GClosureNotify) g_free, G_CONNECT_DEFAULT);
+                               closure_free_data, G_CONNECT_DEFAULT);
       if (g_cancellable_is_cancelled (cancellable))
         g_source_set_ready_time (source, 0);
     }
