From 8d463acb093e65f8dab6a91fee95066e6ece48ee Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 19:42:03 -0700
Subject: [PATCH 34/37] glib, gio: Build glib-unix and GIO's Unix streams on
 WebAssembly

0008 left out glib-unix.c and GIO's Unix sources, so glib-unix.h's
functions were declared but failed to link, and there were no
GUnixInputStream, GUnixOutputStream or GFileDescriptorBased. Emscripten's
file descriptors (files, pipes, /dev/null) take them as they are; the
rest of the Unix sources need mounts, desktop files or D-Bus.

- Build glib-unix.c, without the Unix signal sources, which glib-unix.h
  no longer declares there: gmain.c handles no signals on WebAssembly,
  where no other process can send one.
  g_unix_fd_query_path() fails with G_FILE_ERROR_NOSYS, since Emscripten's
  file systems have no /proc nor another way to name an fd's file.
- Build gfiledescriptorbased.c, giounix-private.c and the Unix input and
  output streams, install their headers and gio-unix-2.0.pc.
- _g_fd_is_pollable(): Emscripten declares epoll but fails every call, and
  its poll() only follows pipes and sockets, so those are what is
  pollable.
- Let GUnixFDSource take closures again.

Upstream-Status: Inappropriate [Wasm-specific]
---
 gio/giounix-private.c    | 16 +++++++++++++++-
 gio/meson.build          | 18 +++++++++++++++++-
 glib/glib-unix.c         | 10 ++++++++++
 glib/glib-unix.h         |  3 +++
 glib/meson.build         |  5 +----
 gobject/gsourceclosure.c | 10 ++++++----
 6 files changed, 52 insertions(+), 10 deletions(-)

diff --git a/gio/giounix-private.c b/gio/giounix-private.c
index b085b2535..27b08e223 100644
--- a/gio/giounix-private.c
+++ b/gio/giounix-private.c
@@ -65,7 +65,21 @@ _g_fd_is_pollable (int fd)
    * absolute certainty:
    */
 
-#if defined (HAVE_EPOLL_CREATE1)
+#if defined (G_PLATFORM_WASM)
+  /*
+   * WebAssembly
+   *
+   * Emscripten declares epoll but fails every call with ENOSYS.  Its poll()
+   * only follows pipes and sockets; anything else it reports ready at once.
+   */
+
+  struct stat st;
+
+  if (G_TEMP_FAILURE_RETRY (fstat (fd, &st)) == -1)
+    return FALSE;
+
+  return S_ISFIFO (st.st_mode) || S_ISSOCK (st.st_mode);
+#elif defined (HAVE_EPOLL_CREATE1)
   /*
    * Linux
    *
diff --git a/gio/meson.build b/gio/meson.build
index 132617d04..ac450a888 100644
--- a/gio/meson.build
+++ b/gio/meson.build
@@ -502,6 +502,22 @@ elif host_system == 'windows'
   install_headers(gio_win32_include_headers, subdir : 'gio-win32-2.0/gio')
 elif host_system == 'emscripten'
   contenttype_sources += files('gcontenttype-wasm.c')
+
+  # Emscripten's file descriptors (files, pipes, /dev/null) take the Unix
+  # streams; the rest of the Unix sources need mounts, desktop files or
+  # D-Bus.
+  unix_sources = files(
+    'gfiledescriptorbased.c',
+    'giounix-private.c',
+    'gunixinputstream.c',
+    'gunixoutputstream.c',
+  )
+  gio_unix_include_headers = files(
+    'gfiledescriptorbased.h',
+    'gunixinputstream.h',
+    'gunixoutputstream.h',
+  )
+  install_headers(gio_unix_include_headers, subdir : 'gio-unix-2.0/gio')
   unix_sources += files('gmemorymonitorwasm.c')
 endif
 
@@ -978,7 +994,7 @@ if host_system == 'windows'
     description : 'Windows specific headers for glib I/O library',
   )
   meson.override_dependency('gio-windows-2.0', libgio_dep)
-elif host_system != 'emscripten'
+else
   pkg.generate(requires : ['gobject-2.0', 'gio-2.0'],
     subdirs : ['gio-unix-2.0'],
     version : glib_version,
diff --git a/glib/glib-unix.c b/glib/glib-unix.c
index 24a20dfa3..107bbdda2 100644
--- a/glib/glib-unix.c
+++ b/glib/glib-unix.c
@@ -192,6 +192,9 @@ g_unix_set_fd_nonblocking (gint       fd,
 #endif
 }
 
+/* gmain.c handles no Unix signals on WebAssembly, where no other process
+ * can send one, so there are no signal sources. */
+#ifndef G_PLATFORM_WASM
 /**
  * g_unix_signal_source_new:
  * @signum: A signal number
@@ -294,6 +297,7 @@ g_unix_signal_add (int         signum,
 {
   return g_unix_signal_add_full (G_PRIORITY_DEFAULT, signum, handler, user_data, NULL);
 }
+#endif
 
 typedef struct
 {
@@ -1006,6 +1010,12 @@ g_unix_fd_query_path (int      fd,
   g_set_error (error, G_FILE_ERROR, G_FILE_ERROR_NOSYS,
                "g_unix_fd_query_path() not supported on HURD");
   return NULL;
+#elif defined(G_PLATFORM_WASM)
+  /* Emscripten's file systems have no /proc, nor another way to name the
+   * file an fd is open on. */
+  g_set_error (error, G_FILE_ERROR, G_FILE_ERROR_NOSYS,
+               "g_unix_fd_query_path() not supported on WebAssembly");
+  return NULL;
 #else
   #error "g_unix_fd_query_path() not supported on this platform"
 #endif
diff --git a/glib/glib-unix.h b/glib/glib-unix.h
index 86f3d61ab..54be660f3 100644
--- a/glib/glib-unix.h
+++ b/glib/glib-unix.h
@@ -70,6 +70,8 @@ gboolean g_unix_set_fd_nonblocking (gint       fd,
                                     gboolean   nonblock,
                                     GError   **error);
 
+/* WebAssembly has no Unix signal sources: no other process can signal it. */
+#ifndef G_PLATFORM_WASM
 GLIB_AVAILABLE_IN_2_30
 GSource *g_unix_signal_source_new  (gint signum);
 
@@ -84,6 +86,7 @@ GLIB_AVAILABLE_IN_2_30
 guint    g_unix_signal_add         (gint        signum,
                                     GSourceFunc handler,
                                     gpointer    user_data);
+#endif
 
 /**
  * GUnixFDSourceFunc:
diff --git a/glib/meson.build b/glib/meson.build
index 8c1cd7661..df8056d73 100644
--- a/glib/meson.build
+++ b/glib/meson.build
@@ -380,10 +380,7 @@ if host_system == 'windows'
     glib_sources += files('dirent/wdirent.c')
   endif
 else
-  glib_sources += files('giounix.c')
-  if host_system != 'emscripten'
-    glib_sources += files('glib-unix.c')
-  endif
+  glib_sources += files('giounix.c', 'glib-unix.c')
   if process_spawn_allowed
     glib_sources += files('gspawn-posix.c')
   else
