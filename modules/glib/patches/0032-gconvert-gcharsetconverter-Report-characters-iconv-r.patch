@@ -740,6 +893,7 @@ g_convert_with_fallback (const gchar *str,
     *bytes_written = outp - dest;	/* Doesn't include '\0' */
 
   g_free (utf8);
+  g_clear_pointer (&replaced, g_array_unref);
 
   if (have_error)
     {
