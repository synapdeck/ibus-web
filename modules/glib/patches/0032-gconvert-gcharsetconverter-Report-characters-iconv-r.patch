From 6426bdc62f82e68cbe94ad3f4ef8b49fe955ac9b Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 19:00:40 -0700
Subject: [PATCH 32/36] gconvert, gcharsetconverter: Report characters iconv()
 replaces
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Some iconv() implementations, musl's among them, convert a character the
target charset lacks to a replacement ('*' in musl's case) and count it
as an irreversible conversion instead of failing with EILSEQ, and forget
that count when a later character ends the same call with an error
(running out of output room, an incomplete character at the end of the
input, or an invalid one). g_convert() reported such a conversion as an
illegal sequence only when the call that made it succeeded,
g_convert_with_fallback() kept the replacement where the caller asked
for its fallback, and GCharsetConverter neither reported an error nor
used its fallback.

- GCharsetConverter converts what a call consumed again a character at a
  time when the call reports an irreversible conversion, or fails after
  consuming input on such an iconv(), and treats the replaced character
  as EILSEQ, so the fallback replaces it or the error reports it.
- g_convert_with_fallback() does the same for its UTF-8 input, also when
  a call runs out of output room.
- g_convert_with_iconv() starts again from a reset converter, with room
  for all the output or with only the complete characters, so that one
  call converts everything and reports the count.

Whether iconv() replaces is probed once, by converting "½" to ASCII.
Where it fails with EILSEQ instead, as glibc's does, the new paths for
failing calls are never taken; a target that asks for transliteration
("//TRANSLIT") still gets iconv()'s replacements.

Upstream-Status: Pending
---
 gio/gcharsetconverter.c | 126 +++++++++++++++++++++++++++++++++++++-
 glib/gconvert.c         | 130 +++++++++++++++++++++++++++++++++++++++-
 2 files changed, 252 insertions(+), 4 deletions(-)

diff --git a/gio/gcharsetconverter.c b/gio/gcharsetconverter.c
index c8944f3a3..f8ff3549c 100644
--- a/gio/gcharsetconverter.c
+++ b/gio/gcharsetconverter.c
@@ -25,6 +25,7 @@
 #include "gcharsetconverter.h"
 
 #include <errno.h>
+#include <string.h>
 
 #include "ginitable.h"
 #include "gioerror.h"
@@ -247,6 +248,85 @@ g_charset_converter_reset (GConverter *converter)
   conv->n_fallback_errors = 0;
 }
 
+/* Whether iconv() converts a character the target charset lacks to a
+ * replacement and counts it as an irreversible conversion, as musl's does,
+ * rather than failing with EILSEQ.  Such an iconv() forgets the count when a
+ * later character ends the call with an error, so a call that fails after
+ * converting something may have replaced a character too. */
+static gboolean
+iconv_replaces_unrepresentable (void)
+{
+  static gsize replaces = 0;
+
+  if (g_once_init_enter (&replaces))
+    {
+      GIConv cd = g_iconv_open ("ASCII", "UTF-8");
+      gsize result = 1;
+
+      if (cd != (GIConv) -1)
+        {
+          gchar in[] = "\xc2\xbd";
+          gchar out[8];
+          gchar *inp = in, *outp = out;
+          gsize in_left = 2, out_left = sizeof out;
+
+          if (g_iconv (cd, &inp, &in_left, &outp, &out_left) != (gsize) -1)
+            result = 2;
+          g_iconv_close (cd);
+        }
+
+      g_once_init_leave (&replaces, result);
+    }
+
+  return replaces == 2;
+}
+
+/* Converts a character at a time, up to the first one iconv() converts
+ * irreversibly, and fails there with EILSEQ.  Returns 0 once all the input
+ * is converted, or -1 with errno set where it stopped. */
+static gsize
+convert_reversibly (GIConv   cd,
+                    gchar  **inbuf,
+                    gsize   *inbytes_left,
+                    gchar  **outbuf,
+                    gsize   *outbytes_left)
+{
+  while (*inbytes_left > 0)
+    {
+      gchar *in = NULL, *out = NULL;
+      gsize in_size, in_left, out_left = 0;
+      gsize res = (gsize) -1;
+
+      /* The shortest input iconv() takes is one whole character. */
+      for (in_size = 1; in_size <= *inbytes_left; in_size++)
+        {
+          in = *inbuf;
+          in_left = in_size;
+          out = *outbuf;
+          out_left = *outbytes_left;
+          res = g_iconv (cd, &in, &in_left, &out, &out_left);
+          if (res != (gsize) -1 || errno != EINVAL)
+            break;
+        }
+
+      if (res == (gsize) -1)
+        return res;
+
+      if (res != 0)
+        {
+          errno = EILSEQ;
+          return (gsize) -1;
+        }
+
+      *inbytes_left -= (gsize) (in - *inbuf);
+      *inbuf = in;
+      *outbuf = out;
+      *outbytes_left = out_left;
+    }
+
+  return 0;
+}
+
 static GConverterResult
 g_charset_converter_convert (GConverter       *converter,
 			     const void       *inbuf,
@@ -264,6 +344,7 @@ g_charset_converter_convert (GConverter       *converter,
   gchar *inbufp, *outbufp;
   gsize in_left, out_left;
   int errsv;
+  int iconv_errno;
   gboolean reset;
 
   conv = G_CHARSET_CONVERTER (converter);
@@ -303,9 +384,48 @@ g_charset_converter_convert (GConverter       *converter,
                    NULL, &in_left,
                    &outbufp, &out_left);
   else
-    res = g_iconv (conv->iconv,
-                   &inbufp, &in_left,
-                   &outbufp, &out_left);
+    {
+      res = g_iconv (conv->iconv,
+                     &inbufp, &in_left,
+                     &outbufp, &out_left);
+      iconv_errno = errno;
+
+      /* Some iconv() implementations, musl's among them, write a replacement
+       * for a character the target charset lacks and count it as an
+       * irreversible conversion instead of failing with EILSEQ, and forget
+       * the count when a later character ends the call with an error.
+       * Converting what this call consumed again a character at a time
+       * finds that character, so it is reported, or replaced by the
+       * fallback, as EILSEQ would have it.  iconv() can't rewind a shift
+       * state, so input in a stateful charset that changes state within
+       * this input may be read wrongly up to that character.  A target that
+       * asks for transliteration ("//TRANSLIT") gets its replacements on
+       * purpose. */
+      if (strstr (conv->to, "//") == NULL &&
+          ((res != (gsize) -1 && res != 0) ||
+           (res == (gsize) -1 && inbufp > (char *) inbuf &&
+            iconv_replaces_unrepresentable ())))
+        {
+          gboolean failed = res == (gsize) -1;
+          gsize consumed = (gsize) (inbufp - (char *) inbuf);
+
+          inbufp = (char *) inbuf;
+          in_left = consumed;
+          outbufp = (char *) outbuf;
+          out_left = outbuf_size;
+          res = convert_reversibly (conv->iconv,
+                                    &inbufp, &in_left,
+                                    &outbufp, &out_left);
+          in_left += inbuf_size - consumed;
+
+          if (res == 0 && failed)
+            res = (gsize) -1;
+          else
+            iconv_errno = errno;
+        }
+
+      errno = iconv_errno;
+    }
 
   g_assert (inbufp >= (char *) inbuf);
   g_assert (outbufp >= (char *) outbuf);
diff --git a/glib/gconvert.c b/glib/gconvert.c
index f10aeffde..4fdf9e39d 100644
--- a/glib/gconvert.c
+++ b/glib/gconvert.c
@@ -212,6 +212,39 @@ g_iconv_close (GIConv converter)
   return iconv_close (cd);
 }
 
+/* Whether iconv() converts a character the target charset lacks to a
+ * replacement and counts it as an irreversible conversion, as musl's does,
+ * rather than failing with EILSEQ.  Such an iconv() forgets the count when a
+ * later character ends the call with an error, so a call that fails after
+ * converting something may have replaced a character too. */
+static gboolean
+iconv_replaces_unrepresentable (void)
+{
+  static gsize replaces = 0;
+
+  if (g_once_init_enter (&replaces))
+    {
+      GIConv cd = g_iconv_open ("ASCII", "UTF-8");
+      gsize result = 1;
+
+      if (cd != (GIConv) -1)
+        {
+          gchar in[] = "\xc2\xbd";
+          gchar out[8];
+          gchar *inp = in, *outp = out;
+          gsize in_left = 2, out_left = sizeof out;
+
+          if (g_iconv (cd, &inp, &in_left, &outp, &out_left) != (gsize) -1)
+            result = 2;
+          g_iconv_close (cd);
+        }
+
+      g_once_init_leave (&replaces, result);
+    }
+
+  return replaces == 2;
+}
+
 static GIConv
 open_converter (const gchar *to_codeset,
 		const gchar *from_codeset,
@@ -314,6 +347,7 @@ g_convert_with_iconv (const gchar *str,
   gboolean have_error = FALSE;
   gboolean done = FALSE;
   gboolean reset = FALSE;
+  gsize limit;
   
   g_return_val_if_fail (converter != (GIConv) -1, NULL);
      
@@ -321,6 +355,7 @@ g_convert_with_iconv (const gchar *str,
     len = strlen (str);
 
   p = str;
+  limit = len;
   inbytes_remaining = len;
   outbuf_size = len + NUL_TERMINATOR_LENGTH;
   
@@ -329,11 +364,45 @@ g_convert_with_iconv (const gchar *str,
 
   while (!done && !have_error)
     {
+      const gchar *p_start = p;
+
       if (reset)
         err = g_iconv (converter, NULL, &inbytes_remaining, &outp, &outbytes_remaining);
       else
         err = g_iconv (converter, (char **)&p, &inbytes_remaining, &outp, &outbytes_remaining);
 
+      /* A call that runs out of room for the output, or ends in an
+       * incomplete character, after converting something may have lost the
+       * count of characters it replaced.  Start again from a reset
+       * converter, with room for all the output, or with only the complete
+       * characters, so that one call converts them all and reports the
+       * count. */
+      if (err == (gsize) -1 && !reset && p != p_start)
+        {
+          int errsv = errno;
+
+          if ((errsv == E2BIG || errsv == EINVAL) &&
+              iconv_replaces_unrepresentable ())
+            {
+              if (errsv == E2BIG)
+                {
+                  outbuf_size *= 2;
+                  dest = g_realloc (dest, outbuf_size);
+                }
+              else
+                limit = (gsize) (p - str);
+
+              g_iconv (converter, NULL, NULL, NULL, NULL);
+              p = str;
+              inbytes_remaining = limit;
+              outp = dest;
+              outbytes_remaining = outbuf_size - NUL_TERMINATOR_LENGTH;
+              continue;
+            }
+
+          errno = errsv;
+        }
+
       if (err == (gsize) -1)
 	{
 	  switch (errno)
@@ -572,6 +641,7 @@ g_convert_with_fallback (const gchar *str,
   gsize outbuf_size;
   gboolean have_error = FALSE;
   gboolean done = FALSE;
+  gboolean by_char = FALSE;
 
   GError *local_error = NULL;
   
@@ -643,9 +713,63 @@ g_convert_with_fallback (const gchar *str,
 
   while (!done && !have_error)
     {
+      const gchar *p_start = p;
+      gchar *outp_start = outp;
+      gsize inbytes_start = inbytes_remaining;
+      gsize outbytes_start = outbytes_remaining;
       gsize inbytes_tmp = inbytes_remaining;
+
+      if (by_char && p && !save_p)
+        inbytes_tmp = MIN (inbytes_remaining, (gsize) (g_utf8_next_char (p) - p));
       err = g_iconv (cd, (char **)&p, &inbytes_tmp, &outp, &outbytes_remaining);
-      inbytes_remaining = inbytes_tmp;
+      if (p_start)
+        inbytes_remaining = inbytes_start - (gsize) (p - p_start);
+      else
+        inbytes_remaining = inbytes_tmp;
+
+      /* Some iconv() implementations, musl's among them, write a replacement
+       * for a character the target codeset lacks and count it as an
+       * irreversible conversion instead of failing with EILSEQ.  Converting
+       * the string again a character at a time finds that character, so the
+       * fallback replaces it as it would on EILSEQ.  Such an iconv() forgets
+       * the count when it runs out of room for the output, so that is
+       * converted again too.  A target that asks for transliteration
+       * ("//TRANSLIT") gets its replacements on purpose. */
+      if (err == (gsize) -1 && p_start && p != p_start && !by_char && !save_p)
+        {
+          int errsv = errno;
+
+          if (errsv == E2BIG && strstr (to_codeset, "//") == NULL &&
+              iconv_replaces_unrepresentable ())
+            {
+              p = p_start;
+              outp = outp_start;
+              inbytes_remaining = inbytes_start;
+              outbytes_remaining = outbytes_start;
+              by_char = TRUE;
+              continue;
+            }
+
+          errno = errsv;
+        }
+
+      if (err != (gsize) -1 && err != 0 && p_start &&
+          strstr (to_codeset, "//") == NULL)
+        {
+          p = p_start;
+          outp = outp_start;
+          inbytes_remaining = inbytes_start;
+          outbytes_remaining = outbytes_start;
+
+          if (!by_char && !save_p)
+            {
+              by_char = TRUE;
+              continue;
+            }
+
+          err = (gsize) -1;
+          errno = EILSEQ;
+        }
 
       if (err == (gsize) -1)
 	{
@@ -719,6 +843,10 @@ g_convert_with_fallback (const gchar *str,
 	      inbytes_remaining = save_inbytes;
 	      save_p = NULL;
 	    }
+	  else if (p && inbytes_remaining > 0)
+	    {
+	      /* Converting a character at a time; go on with the next. */
+	    }
 	  else if (p)
 	    {
 	      /* call g_iconv with NULL inbuf to cleanup shift state */
