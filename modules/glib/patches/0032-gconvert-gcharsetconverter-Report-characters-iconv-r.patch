+/* Whether iconv() converts a character the target charset lacks to a
+ * replacement and counts it as an irreversible conversion, as musl's does,
+ * rather than failing with EILSEQ.  Such an iconv() forgets the count when a
+ * later character ends the call with an error, so a call that fails after
+ * converting something may have replaced a character too. */
+static gboolean
+iconv_replaces_unrepresentable (void)
+{
+  static gsize replaces = 0;
+
+  if (g_once_init_enter (&replaces))
+    {
+      GIConv cd = g_iconv_open ("ASCII", "UTF-8");
+      gsize result = 1;
+
+      if (cd != (GIConv) -1)
+        {
+          gchar in[] = "\xc2\xbd";
+          gchar out[8];
+          gchar *inp = in, *outp = out;
+          gsize in_left = 2, out_left = sizeof out;
+
+          if (g_iconv (cd, &inp, &in_left, &outp, &out_left) != (gsize) -1)
+            result = 2;
+          g_iconv_close (cd);
+        }
+
+      g_once_init_leave (&replaces, result);
+    }
+
+  return replaces == 2;
+}
