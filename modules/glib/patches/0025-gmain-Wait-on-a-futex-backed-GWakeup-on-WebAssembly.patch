From 05e887d995a6e3408246618dbc3d8a8c887a673a Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Wed, 30 Sep 2026 14:55:45 -0700
Subject: [PATCH 25/37] gmain: Wait on a futex-backed GWakeup on WebAssembly

On WebAssembly g_wakeup_new() returned NULL, the main context never
waited on anything and every poll used a zero timeout, so a blocking
g_main_context_iteration() or g_main_loop_run() busy-spun. That
includes GLib's worker context, whose thread GTask's type
initialization starts, and GDBus's shared thread.

A GWakeup there is now a counter that g_wakeup_signal() bumps and
wakes with emscripten_futex_wake(), and g_wakeup_wait() sleeps on it
with emscripten_futex_wait() until it moves past the value
g_wakeup_acknowledge() last recorded or a timeout passes. A blocking
iteration waits on the context's wakeup with the computed timeout
instead of calling poll(), which on Emscripten can't wait: it ignores a
timeout on the main thread and, from a pthread, is proxied to the main
thread and only returns once that thread gets back to its event loop.
With fds to watch, they are probed with a zero timeout between waits of
at most 10 ms. g_main_context_check() acknowledges the wakeup, which is
not among the polled fds.

Non-blocking iteration is unchanged: fds are probed once with a zero
timeout, and with none nothing is called. g_wakeup_get_pollfd() still
aborts, since nothing can poll a futex.

Upstream-Status: Inappropriate [Wasm-specific]
---
 glib/gmain.c   | 68 +++++++++++++++++++++++++++++++++++++++++++++-----
 glib/gwakeup.c | 61 +++++++++++++++++++++++++++++++++++++++-----
 glib/gwakeup.h |  4 +++
 3 files changed, 121 insertions(+), 12 deletions(-)

diff --git a/glib/gmain.c b/glib/gmain.c
index 268de6ac4..f0ced2961 100644
--- a/glib/gmain.c
+++ b/glib/gmain.c
@@ -714,10 +714,6 @@ g_main_context_new_with_flags (GMainContextFlags flags)
 #ifndef G_PLATFORM_WASM
   g_wakeup_get_pollfd (context->wakeup, &context->wake_up_rec);
   g_main_context_add_poll_unlocked (context, 0, &context->wake_up_rec);
-#else
-  /* No wakeup fd is polled, so keep the record from matching a source
-   * that polls fd 0. */
-  context->wake_up_rec.fd = -1;
 #endif
 
 #ifdef G_MAIN_POLL_DEBUG
@@ -4263,6 +4259,12 @@ g_main_context_check_unlocked (GMainContext *context,
 
   TRACE (GLIB_MAIN_CONTEXT_BEFORE_CHECK (context, max_priority, fds, n_fds));
 
+#ifdef G_PLATFORM_WASM
+  /* The wakeup is not among the fds.  Whatever signalled it did so after
+   * changing what the next prepare will look at, so acknowledging it
+   * here loses nothing. */
+  g_wakeup_acknowledge (context->wakeup);
+#else
   for (i = 0; i < n_fds; i++)
     {
       if (fds[i].fd == context->wake_up_rec.fd)
@@ -4275,6 +4277,7 @@ g_main_context_check_unlocked (GMainContext *context,
           break;
         }
     }
+#endif
 
   /* If the set of poll file descriptors changed, bail out
    * and let the main loop rerun
@@ -4511,9 +4514,7 @@ g_main_context_iterate_unlocked (GMainContext *context,
       context->cached_poll_array = fds = g_new (GPollFD, nfds);
     }
 
-#ifndef G_PLATFORM_WASM
   if (!block)
-#endif
     timeout_usec = 0;
 
   g_main_context_poll_unlocked (context, timeout_usec, max_priority, fds, nfds);
@@ -4797,6 +4798,54 @@ g_main_loop_get_context (GMainLoop *loop)
   return loop->context;
 }
 
+#ifdef G_PLATFORM_WASM
+/* Between probes of the fds, when there are any.  An fd turning ready
+ * doesn't signal the wakeup, so this bounds how late it is noticed; each
+ * probe is a call proxied to the main thread, so shorter slices cost the
+ * main thread more. */
+#define WASM_POLL_SLICE_USEC (10 * G_TIME_SPAN_MILLISECOND)
+
+/* Emscripten's poll() can't wait: on the main thread it ignores the
+ * timeout, and from a pthread it is proxied to the main thread, where a
+ * wait only ends once that thread returns to its event loop.  So the fds
+ * are only ever probed, and the wait happens on the context's wakeup,
+ * which every change to the context from another thread signals. */
+static int
+g_main_context_poll_wasm (GWakeup  *wakeup,
+                          GPollFunc poll_func,
+                          GPollFD  *fds,
+                          int       n_fds,
+                          gint64    timeout_usec)
+{
+  gint64 deadline = -1;
+
+  if (timeout_usec > 0)
+    deadline = g_get_monotonic_time () + timeout_usec;
+
+  for (;;)
+    {
+      gint64 wait_usec = -1;
+      int ret = n_fds ? (*poll_func) (fds, n_fds, 0) : 0;
+
+      if (ret != 0 || timeout_usec == 0)
+        return ret;
+
+      if (deadline >= 0)
+        {
+          wait_usec = deadline - g_get_monotonic_time ();
+          if (wait_usec <= 0)
+            return 0;
+        }
+
+      if (n_fds && (wait_usec < 0 || wait_usec > WASM_POLL_SLICE_USEC))
+        wait_usec = WASM_POLL_SLICE_USEC;
+
+      if (g_wakeup_wait (wakeup, wait_usec))
+        return 0;
+    }
+}
+#endif
+
 /* HOLDS: context's lock */
 static void
 g_main_context_poll_unlocked (GMainContext *context,
@@ -4828,6 +4877,12 @@ g_main_context_poll_unlocked (GMainContext *context,
 #endif
       poll_func = context->poll_func;
 
+#ifdef G_PLATFORM_WASM
+      UNLOCK_CONTEXT (context);
+      ret = g_main_context_poll_wasm (context->wakeup, poll_func, fds, n_fds,
+                                      timeout_usec);
+      LOCK_CONTEXT (context);
+#else
 #if defined(HAVE_PPOLL) && defined(HAVE_POLL)
       if (poll_func == g_poll)
         {
@@ -4854,6 +4909,7 @@ g_main_context_poll_unlocked (GMainContext *context,
           ret = (*poll_func) (fds, n_fds, timeout_msec);
           LOCK_CONTEXT (context);
         }
+#endif /* !G_PLATFORM_WASM */
 
       errsv = errno;
       if (ret < 0 && errsv != EINTR)
diff --git a/glib/gwakeup.c b/glib/gwakeup.c
index 9f6e6d524..c503ec4bc 100644
--- a/glib/gwakeup.c
+++ b/glib/gwakeup.c
@@ -112,8 +112,13 @@ g_wakeup_free (GWakeup *wakeup)
 
 #ifdef G_PLATFORM_WASM
 #ifdef GLIB_COMPILATION
+#include "gatomic.h"
 #include "gmessages.h"
+#include "gslice.h"
 #endif
+#include <emscripten/threading.h>
+#include <limits.h>
+#include <math.h>
 #else /* !G_PLATFORM_WASM */
 #include "glib-unix.h"
 #include <fcntl.h>
@@ -123,9 +128,16 @@ g_wakeup_free (GWakeup *wakeup)
 #endif
 #endif /*G_PLATFORM_WASM*/
 
+/* There are no file descriptors to signal through on WebAssembly, so a
+ * wakeup is a futex: signalling bumps @signals and wakes its waiters, and
+ * g_wakeup_wait() sleeps while @signals still equals the value last
+ * acknowledged.  Only equality is compared, so the counter may wrap. */
 struct _GWakeup
 {
-#ifndef G_PLATFORM_WASM
+#ifdef G_PLATFORM_WASM
+  gint signals;       /* (atomic) */
+  gint acknowledged;  /* (atomic) */
+#else
   gint fds[2];
 #endif
 };
@@ -145,7 +157,7 @@ GWakeup *
 g_wakeup_new (void)
 {
 #ifdef G_PLATFORM_WASM
-  return NULL;
+  return g_slice_new0 (GWakeup);
 #else
   GError *error = NULL;
   GWakeup *wakeup;
@@ -197,7 +209,8 @@ g_wakeup_get_pollfd (GWakeup *wakeup,
                      GPollFD *poll_fd)
 {
 #ifdef G_PLATFORM_WASM
-  g_error ("g_wakeup_get_pollfd is no-op on WebAssembly");
+  /* Nothing can poll a futex; see g_wakeup_wait(). */
+  g_error ("g_wakeup_get_pollfd is not supported on WebAssembly");
 #else
   poll_fd->fd = wakeup->fds[0];
   poll_fd->events = G_IO_IN;
@@ -221,7 +234,9 @@ g_wakeup_get_pollfd (GWakeup *wakeup,
 void
 g_wakeup_acknowledge (GWakeup *wakeup)
 {
-#ifndef G_PLATFORM_WASM
+#ifdef G_PLATFORM_WASM
+  g_atomic_int_set (&wakeup->acknowledged, g_atomic_int_get (&wakeup->signals));
+#else
   int res;
 
   if (wakeup->fds[1] == -1)
@@ -262,7 +277,10 @@ g_wakeup_acknowledge (GWakeup *wakeup)
 void
 g_wakeup_signal (GWakeup *wakeup)
 {
-#ifndef G_PLATFORM_WASM
+#ifdef G_PLATFORM_WASM
+  g_atomic_int_inc (&wakeup->signals);
+  emscripten_futex_wake (&wakeup->signals, INT_MAX);
+#else
   int res;
 
   if (wakeup->fds[1] == -1)
@@ -305,9 +323,40 @@ g_wakeup_free (GWakeup *wakeup)
 
   if (wakeup->fds[1] != -1)
     close (wakeup->fds[1]);
+#endif
 
   g_slice_free (GWakeup, wakeup);
-#endif
 }
 
+#ifdef G_PLATFORM_WASM
+/*< private >
+ * g_wakeup_wait:
+ * @wakeup: a #GWakeup
+ * @timeout_usec: the longest to wait, in microseconds, or -1 for no limit
+ *
+ * Waits until @wakeup is signalled or @timeout_usec passes, returning at
+ * once if it was signalled since the last g_wakeup_acknowledge().  The wait
+ * may also end early for no reason, so callers recheck their own deadline.
+ *
+ * Returns: %TRUE if @wakeup is signalled
+ */
+gboolean
+g_wakeup_wait (GWakeup *wakeup,
+               gint64   timeout_usec)
+{
+  gint acknowledged = g_atomic_int_get (&wakeup->acknowledged);
+
+  /* A bare atomic wait would sleep through work other threads hand this
+   * one and wait on: the main thread runs the calls pthreads proxy to it
+   * (their file system calls among them), and dlopen() blocks until every
+   * thread has loaded the new module.  emscripten_futex_wait() is woken
+   * for both and does the work before returning. */
+  if (timeout_usec != 0 && g_atomic_int_get (&wakeup->signals) == acknowledged)
+    emscripten_futex_wait (&wakeup->signals, (guint32) acknowledged,
+                           timeout_usec < 0 ? INFINITY : timeout_usec / 1000.0);
+
+  return g_atomic_int_get (&wakeup->signals) != acknowledged;
+}
+#endif
+
 #endif /* !_WIN32 */
diff --git a/glib/gwakeup.h b/glib/gwakeup.h
index 0905fde2f..f5d37ec20 100644
--- a/glib/gwakeup.h
+++ b/glib/gwakeup.h
@@ -33,5 +33,9 @@ void            g_wakeup_get_pollfd     (GWakeup *wakeup,
                                          GPollFD *poll_fd);
 void            g_wakeup_signal         (GWakeup *wakeup);
 void            g_wakeup_acknowledge    (GWakeup *wakeup);
+#ifdef G_PLATFORM_WASM
+gboolean        g_wakeup_wait           (GWakeup *wakeup,
+                                         gint64   timeout_usec);
+#endif
 
 #endif
