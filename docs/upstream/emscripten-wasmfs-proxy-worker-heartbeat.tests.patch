@@ -0,0 +1,41 @@
+// A ProxyWorker that is destroyed leaves nothing running against its queue,
+// while the Worker its thread ran on sits idle in the pool and then hosts
+// another thread. Each wait is long enough for the 50 ms heartbeat to fire
+// several times.
+
+#include <assert.h>
+#include <condition_variable>
+#include <emscripten/eventloop.h>
+#include <mutex>
+#include <stdio.h>
+#include <stdlib.h>
+#include <thread>
+
+#include "thread_utils.h"
+
+#define IDLE_MS 500
+
+// A ProxyWorker can't be created on the main browser thread.
+static void use_worker() {
+  std::thread([] {
+    emscripten::ProxyWorker worker;
+    bool ran = false;
+    worker([&] { ran = true; });
+    assert(ran);
+  }).join();
+}
+
+static void second_idle(void*) {
+  printf("done\n");
+  exit(0);
+}
+
+static void first_idle(void*) {
+  use_worker();
+  emscripten_set_timeout(second_idle, IDLE_MS, nullptr);
+}
+
+int main() {
+  use_worker();
+  emscripten_set_timeout(first_idle, IDLE_MS, nullptr);
+}
