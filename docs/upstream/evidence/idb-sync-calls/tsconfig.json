{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@ibus-web/tsconfig/node.json",
  "compilerOptions": {
    // Playwright's types name the DOM's element types; the DOM's library
    // declares WebAssembly whole.
    "lib": ["es2023", "dom"],
    "types": ["node"]
  }
}
