// .hk links to hk's pkl package, built by Nix: the `package://` form hk
// documents can't resolve without the network.
amends ".hk/pkl/Config.pkl"

import ".hk/pkl/Builtins.pkl"

// Links to what Nix builds for a type check. Without one, a hook run skips
// the check that reads it rather than failing on a missing input; with
// HK_REQUIRE_NIX_INPUTS set, the check runs anyway and fails.
local nixInputs =
  List("runtime/wasmfs-idb/src/emscripten-types", "modules/testing/gtest-main/emscripten-types")

local linters = new Mapping<String, Step> {
  ["nixfmt"] = Builtins.nix_fmt
  ["clang-format"] = (Builtins.clang_format) {
    // Preserve upstream formatting so imports and later updates stay reviewable.
    exclude =
      List(
        "runtime/libibus-web/src/ibus/ibusobject.c",
        "runtime/libibus-web/src/ibus/ibusserializable.c",
        "runtime/libibus-web/src/ibus/ibustext.c",
        "runtime/libibus-web/src/ibus/ibusattribute.c",
        "runtime/libibus-web/src/ibus/ibusattrlist.c",
        "runtime/libibus-web/src/ibus/ibuslookuptable.c",
        "runtime/libibus-web/src/ibus/ibusproperty.c",
        "runtime/libibus-web/src/ibus/ibusproplist.c",
        "runtime/libibus-web/src/ibus/ibuskeys.c",
        "runtime/libibus-web/src/ibus/ibuskeyuni.c",
        "runtime/libibus-web/src/ibus/ibusutil.c",
        "runtime/libibus-web/src/ibus/ibuserror.c",
        "runtime/libibus-web/src/ibus/ibusinternal.h",
        "runtime/libibus-web/src/ibus/ibusattrlistprivate.h",
        "runtime/libibus-web/src/ibus/keynamesprivate.h",
        "runtime/libibus-web/include/ibus-1.0/ibusobject.h",
        "runtime/libibus-web/include/ibus-1.0/ibusserializable.h",
        "runtime/libibus-web/include/ibus-1.0/ibustext.h",
        "runtime/libibus-web/include/ibus-1.0/ibusattribute.h",
        "runtime/libibus-web/include/ibus-1.0/ibusattrlist.h",
        "runtime/libibus-web/include/ibus-1.0/ibuslookuptable.h",
        "runtime/libibus-web/include/ibus-1.0/ibusproperty.h",
        "runtime/libibus-web/include/ibus-1.0/ibusproplist.h",
        "runtime/libibus-web/include/ibus-1.0/ibuskeys.h",
        "runtime/libibus-web/include/ibus-1.0/ibuskeysyms.h",
        "runtime/libibus-web/include/ibus-1.0/ibuskeysyms-compat.h",
        "runtime/libibus-web/include/ibus-1.0/ibustypes.h",
        "runtime/libibus-web/include/ibus-1.0/ibusdebug.h",
        "runtime/libibus-web/include/ibus-1.0/ibuserror.h",
        "runtime/libibus-web/include/ibus-1.0/ibusservice.h",
        "runtime/libibus-web/include/ibus-1.0/ibusengine.h",
        "runtime/libibus-web/include/ibus-1.0/ibusenginesimple.h",
        "runtime/libibus-web/include/ibus-1.0/ibusfactory.h",
        "runtime/libibus-web/include/ibus-1.0/ibuskeymap.h",
        "runtime/libibus-web/include/ibus-1.0/ibusmessage.h",
      )
  }
  ["shfmt"] = Builtins.shfmt
  ["oxfmt"] = (Builtins.oxfmt) {
    exclude =
      List(
        // pnpm rewrites its lockfile in its own style on every install.
        "pnpm-lock.yaml",
        // Generated by Nix; actionlint checks the workflow.
        ".github/workflows/*.yml",
        "pnpm-workspace.yaml",
      )
    // The builtin's commands with the config named: oxfmt formats with its
    // own defaults when it finds none, silently, and a named config it can't
    // find fails the step instead. hk's evaluator has no list operations to
    // derive these from the builtin's.
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "oxfmt",
            "-c",
            ".oxfmtrc.jsonc",
            "--check",
            "--no-error-on-unmatched-pattern",
            "{{files}}",
          )
      }
      effect = "read"
    }
    check_list_files = new CommandSpec {
      command = new Command {
        argv =
          List(
            "oxfmt",
            "-c",
            ".oxfmtrc.jsonc",
            "--list-different",
            "--no-error-on-unmatched-pattern",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv =
          List(
            "oxfmt",
            "-c",
            ".oxfmtrc.jsonc",
            "--write",
            "--no-error-on-unmatched-pattern",
            "{{files}}",
          )
      }
      effect = "write"
    }
  }
  ["pkl-format"] = Builtins.pkl_format
  ["oxlint"] = (Builtins.ox_lint) {
    glob = List("**/*.ts", "**/*.mts", "**/*.cts", "**/*.js", "**/*.mjs", "**/*.cjs")
  }
  // One job per directory holding a tsconfig.json, over the files it owns;
  // a JavaScript file or the config itself changing re-checks it too.
  ["tsc"] = (Builtins.tsc) {
    glob =
      List(
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/tsconfig.json",
      )
    // A negative test: its check must fail, which the Nix check asserts.
    exclude = "**/runtime/wasmfs-idb/tests/library-types/**"
    check = new CommandSpec {
      // hk's evaluator leaves interpolation in multi-line strings unexpanded.
      command =
        "nix_inputs='\(nixInputs.join(" "))'\n"
          + """
          for input in $nix_inputs; do
            case "$input" in
            {{workspace}}/*)
              if [ ! -e "$input" ] && [ -z "${HK_REQUIRE_NIX_INPUTS:-}" ]; then
                echo "tsc: skipped {{workspace}}: $input isn't built; enter the dev shell to build it" >&2
                exit 0
              fi
              ;;
            esac
          done
          tsc --noEmit -p {{workspace_indicator}}
          """
      effect = "read"
    }
  }
  // Every tsconfig shares the repository's standard options; the script
  // reads every config git tracks, since a change to one can break another's
  // chain.
  ["tsconfig-extends"] {
    glob = List("**/tsconfig*.json")
    check = new CommandSpec {
      command = "node modules/flake/tsconfig-extends.ts"
      effect = "read"
    }
  }
  // Every file needs its licence, so this lints the whole tree each time.
  ["reuse"] {
    check = new CommandSpec {
      command = "reuse lint"
      effect = "read"
    }
  }
  ["actionlint"] = Builtins.actionlint
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
