// .hk links to hk's pkl package, built by Nix: the `package://` form hk
// documents can't resolve without the network.
amends ".hk/pkl/Config.pkl"

import ".hk/pkl/Builtins.pkl"

// Links to what Nix builds for a type check. Without one, a hook run skips
// the check that reads it rather than failing on a missing input; with
// HK_REQUIRE_NIX_INPUTS set, the check runs anyway and fails.
local nixInputs =
  List("runtime/wasmfs-idb/src/emscripten-types", "modules/testing/gtest-main/emscripten-types")

local linters = new Mapping<String, Step> {
  ["nixfmt"] = Builtins.nix_fmt
  ["clang-format"] = (Builtins.clang_format) {
    // Preserve upstream formatting so imports and later updates stay reviewable.
    // The IBus layer's own sources (see its README) stay formatted: the
    // umbrella ibus.h, ibusweb-private.h, and the reimplemented engine,
    // factory, keymap and service.
    exclude =
      List(
        "runtime/libibus-web/include/ibus-1.0/ibus?*.h",
        "runtime/libibus-web/src/ibus/ibus{attr*,error,internal,keys,keyuni,lookuptable,object,prop*,serializable,text,util}.[ch]",
        "runtime/libibus-web/src/ibus/*[a-z]private.h",
      )
  }
  ["shfmt"] = Builtins.shfmt
  ["oxfmt"] = (Builtins.oxfmt) {
    exclude =
      List(
        // pnpm rewrites its lockfile in its own style on every install.
        "pnpm-lock.yaml",
        // Generated by Nix; actionlint checks the workflow.
        ".github/workflows/*.yml",
        "pnpm-workspace.yaml",
        // Implementation plans quote code verbatim as before/after snippets
        // that formatting embedded code would change.
        "docs/plans/**",
      )
    // The builtin's commands with the config named: oxfmt formats with its
    // own defaults when it finds none, silently, and a named config it can't
    // find fails the step instead. hk's evaluator has no list operations to
    // derive these from the builtin's.
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "oxfmt",
            "-c",
            ".oxfmtrc.jsonc",
            "--check",
            "--no-error-on-unmatched-pattern",
            "{{files}}",
          )
      }
      effect = "read"
    }
    check_list_files = new CommandSpec {
      command = new Command {
        argv =
          List(
            "oxfmt",
            "-c",
            ".oxfmtrc.jsonc",
            "--list-different",
            "--no-error-on-unmatched-pattern",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv =
          List(
            "oxfmt",
            "-c",
            ".oxfmtrc.jsonc",
            "--write",
            "--no-error-on-unmatched-pattern",
            "{{files}}",
          )
      }
      effect = "write"
    }
  }
  ["pkl-format"] = Builtins.pkl_format
  ["oxlint"] = (Builtins.ox_lint) {
    glob = List("**/*.ts", "**/*.mts", "**/*.cts", "**/*.js", "**/*.mjs", "**/*.cjs")
  }
  // One job per directory holding a tsconfig.json, over the files it owns;
  // a JavaScript file or any of the directory's configs changing re-checks
  // it too. Build mode, because a package's tsconfig.json lists its other
  // configs as references and holds no files itself.
  ["tsc"] = (Builtins.tsc) {
    glob =
      List(
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/tsconfig*.json",
      )
    exclude =
      List(
        // A negative test: its check must fail, which the Nix check asserts.
        "**/runtime/wasmfs-idb/tests/library-types/**",
        // A measurement script kept with the evidence it produced, not part
        // of any package.
        "docs/upstream/evidence/**",
      )
    check = new CommandSpec {
      // hk's evaluator leaves interpolation in multi-line strings unexpanded.
      command =
        "nix_inputs='\(nixInputs.join(" "))'\n"
          + """
          for input in $nix_inputs; do
            case "$input" in
            {{workspace}}/*)
              if [ ! -e "$input" ] && [ -z "${HK_REQUIRE_NIX_INPUTS:-}" ]; then
                echo "tsc: skipped {{workspace}}: $input isn't built; enter the dev shell to build it" >&2
                exit 0
              fi
              ;;
            esac
          done
          tsc -b --noEmit {{workspace_indicator}}
          """
      effect = "read"
    }
  }
  // Every tsconfig shares the repository's standard options; the script
  // reads every config git tracks, since a change to one can break another's
  // chain.
  ["tsconfig-extends"] {
    glob = List("**/tsconfig*.json", "packages/tsconfig/*.json")
    check = new CommandSpec {
      command = "node tools/tsconfig-extends/tsconfig-extends.ts"
      effect = "read"
    }
  }
  // Every file needs its licence, so this lints the whole tree each time.
  ["reuse"] {
    // tsc -b writes .tsbuildinfo files while it runs, and reuse lint can find
    // one mid-scan, before it matches git's ignore rules.
    depends = List("tsc")
    check = new CommandSpec {
      command = "reuse lint"
      effect = "read"
    }
  }
  ["actionlint"] = Builtins.actionlint
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
