{
  "name": "@ibus-web/test-browser",
  "private": true,
  "type": "module",
  "exports": {
    "./browsers": {
      "ibus-web-source": "./src/node/browsers.ts",
      "default": "./dist/node/browsers.js"
    },
    "./server": {
      "ibus-web-source": "./src/node/server.ts",
      "default": "./dist/node/server.js"
    }
  },
  "scripts": {
    "build": "status=0; for env in shared worker page node; do tsc -p src/$env || status=1; done; exit $status"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "ibusWeb": {
    "assets": [
      "src/page/index.html"
    ]
  }
}
