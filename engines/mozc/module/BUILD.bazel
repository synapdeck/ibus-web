# The side module the runtime loads. GLib and IBus are the runtime's, which
# it imports, so nothing here links them.
cc_binary(
    name = "mozc.wasm",
    srcs = [
        "module.cc",
        "settings.cc",
        "settings.h",
    ],
    copts = ["@libibusWebCflags@"],
    linkopts = ["@sideModuleFlags@"],
    deps = [
        "//base:config_file_stream",
        "//base:file_util",
        "//base:system_util",
        "//base/protobuf:text_format",
        "//client",
        "//client:client_interface",
        "//config:config_handler",
        "//ibus_web_in_process:in_process",
        "//protocol:config_cc_proto",
        "//session:session_handler_interface",
        "//unix/ibus:ibus_config",
        "//unix/ibus:ibus_config_cc_proto",
        "//unix/ibus:ibus_mozc_lib",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@ibus",
    ],
)
