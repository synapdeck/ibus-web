From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexis Williams <alexis@typedr.at>
Date: Tue, 20 Oct 2026 16:44:28 -0700
Subject: [PATCH] Build system_util for the build machine on macOS without the
 Apple toolchain

A WebAssembly build passes --define TARGET=oss_wasm on to the tools it
builds for the build machine, so on macOS their selections leave out
mac_util while the compiler still defines __APPLE__, and system_util.cc
includes mac_util.h. mac_util_posix gives the tools the part of MacUtil
system_util.cc uses, in C++, since the build has no Apple toolchain for
Objective-C.
---
 src/base/BUILD.bazel           |  5 ++-
 src/base/mac/BUILD.bazel       | 23 ++++++++++
 src/base/mac/mac_util_posix.cc | 80 ++++++++++++++++++++++++++++++++++
 3 files changed, 107 insertions(+), 1 deletion(-)
 create mode 100644 src/base/mac/mac_util_posix.cc

diff --git a/src/base/BUILD.bazel b/src/base/BUILD.bazel
index 6f0fbdf..0d75bcd 100644
--- a/src/base/BUILD.bazel
+++ b/src/base/BUILD.bazel
@@ -581,7 +581,10 @@ mozc_cc_library(
             "//testing:friend_test",
             "@com_microsoft_wil//:wil",
         ],
-    ),
+    ) + select({
+        "//base/mac:mac_util_posix_for_tools": ["//base/mac:mac_util_posix"],
+        "//conditions:default": [],
+    }),
 )
 
 mozc_cc_test(
diff --git a/src/base/mac/BUILD.bazel b/src/base/mac/BUILD.bazel
index 747e26a..3e63c46 100644
--- a/src/base/mac/BUILD.bazel
+++ b/src/base/mac/BUILD.bazel
@@ -29,9 +29,11 @@
 
 # Base library platform dependent code for MacOS.
 
+load("@bazel_skylib//lib:selects.bzl", "selects")
 load(
     "//:build_defs.bzl",
     "mozc_cc_binary",
+    "mozc_cc_library",
     "mozc_objc_library",
     "mozc_objc_test",
     "mozc_select",
@@ -75,6 +77,27 @@ mozc_objc_library(
     visibility = ["//visibility:private"],
 )
 
+# Mozc's selections follow --define TARGET, which a build passes on to its
+# tools for the build machine. In a WebAssembly build on macOS, they leave
+# out mac_util, which system_util.cc includes wherever __APPLE__ is defined.
+selects.config_setting_group(
+    name = "mac_util_posix_for_tools",
+    match_all = [
+        "@platforms//os:macos",
+        "//bazel/cc_target_os:oss_wasm",
+    ],
+)
+
+mozc_cc_library(
+    name = "mac_util_posix",
+    srcs = ["mac_util_posix.cc"],
+    hdrs = ["mac_util.h"],
+    deps = [
+        "//base:const",
+        "@com_google_absl//absl/strings",
+    ],
+)
+
 mozc_objc_library(
     name = "mac_util",
     srcs = [
diff --git a/src/base/mac/mac_util_posix.cc b/src/base/mac/mac_util_posix.cc
new file mode 100644
index 0000000..c03d711
--- /dev/null
+++ b/src/base/mac/mac_util_posix.cc
@@ -0,0 +1,80 @@
