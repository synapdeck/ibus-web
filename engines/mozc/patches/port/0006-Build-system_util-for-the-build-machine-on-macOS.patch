+// The part of MacUtil that system_util.cc uses, without Objective-C, for
+// programs that run on macOS but are built without the Apple toolchain:
+// directories under $HOME/Library, as Foundation gives them for the user's
+// domain, and the OS version from sysctl.
+
+#include <sys/sysctl.h>
+
+#include <cstdlib>
+#include <string>
+
+#include "absl/strings/str_cat.h"
+#include "absl/strings/string_view.h"
+#include "base/const.h"
+#include "base/mac/mac_util.h"
+
+namespace mozc {
+namespace {
+
+std::string GetLibraryDirectory(absl::string_view name) {
+  const char *home = std::getenv("HOME");
+  return absl::StrCat(home == nullptr ? "" : home, "/Library/", name);
+}
+
+}  // namespace
+
+std::string MacUtil::GetApplicationSupportDirectory() {
+  return GetLibraryDirectory("Application Support");
+}
+
+std::string MacUtil::GetCachesDirectory() {
+  return GetLibraryDirectory("Caches");
+}
+
+std::string MacUtil::GetLoggingDirectory() {
+  return absl::StrCat(GetLibraryDirectory("Logs"), "/", kProductPrefix);
+}
+
+std::string MacUtil::GetOSVersionString() {
+  char version[64];
+  size_t size = sizeof(version);
+  if (sysctlbyname("kern.osproductversion", version, &size, nullptr, 0) != 0) {
+    return "";
+  }
+  return version;
+}
+
+std::string MacUtil::GetServerDirectory() {
+  return "/Library/Input Methods/" kProductPrefix ".app/Contents/Resources";
+}
+
+}  // namespace mozc
