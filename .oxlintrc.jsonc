{
  "$schema": "https://unpkg.com/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
  },
}
